// Kleur van de lijn op de kaart. Witte lijnborden (streeklijnen) worden getekend in de kleur van het cijfer.
function lijnKleur(info){
 const k=info&&info.k,t=info&&info.t;
 if(geldigeKleur(k)&&helderheid(k)<=215)return k;
 if(geldigeKleur(t)&&helderheid(t)<=215)return t;
 if(geldigeKleur(k))return LIJN_GRIJS;
 return info&&info.m==='tram'?LIJN_TRAM:LIJN_BUS;
}
// Badge zoals het lijnbord van De Lijn: achtergrond = lijnkleur, cijfer = tekstkleur.
