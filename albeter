// Lijnen met kleur liggen naast elkaar, één strook per kleur (zelfde kleur = één strook).
// Per zoomniveau: [zoom, breedte van één strook, maximale breedte van de hele bundel] in pixels.
const LIJN_STROKEN=[[10,2.2,8],[13,3.5,14],[15,5,22],[17,7,34]];
function pasLijnStijlToe(){
 if(!map||!map.getLayer('golem-lijnen'))return;
 const donker=document.documentElement.dataset.theme==='dark';
