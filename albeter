const SCRIPT = "const PRICE_TIERS = [\n\n      {\n        min: 50,\n        price: 119.95 / 50\n      },\n\n      {\n        min: 25,\n        price: 69.95 / 25\n      },\n\n      {\n        min: 10,\n        price: 34.95 / 10\n      },\n\n      {\n        min: 5,\n        price: 19.95 / 5\n      },\n\n      {\n        min: 1,\n        price: 4.95\n      }\n\n    ];\n\n\n    let cart =\n      JSON.parse(\n        localStorage.getItem(\n          \"eclipse_cart\"\n        ) || \"[]\"\n      );\n\n\n    function getUnitPrice(quantity) {\n\n      for (\n        const tier of PRICE_TIERS\n      ) {\n\n        if (\n          quantity >= tier.min\n        ) {\n\n          return tier.price;\n\n        }\n\n      }\n\n      return 4.95;\n\n    }\n\n\n    function getCartCount() {\n\n      return cart.reduce(\n        (\n          sum,\n          item\n        ) =>\n          sum +\n          item.quantity,\n        0\n      );\n\n    }\n\n\n    function saveCart() {\n\n      localStorage.setItem(\n        \"eclipse_cart\",\n        JSON.stringify(cart)\n      );\n\n      renderCart();\n\n    }\n\n\n    function addToCart() {\n\n      const quantityInput =\n        document.getElementById(\n          \"quantity\"\n        );\n\n\n      let quantity =\n        parseInt(\n          quantityInput.value,\n          10\n        );\n\n\n      if (\n        !quantity ||\n        quantity < 1\n      ) {\n\n        quantity = 1;\n\n      }\n\n\n      const existing =\n        cart.find(\n          item =>\n            item.id ===\n            \"solar-glasses\"\n        );\n\n\n      if (existing) {\n\n        existing.quantity +=\n          quantity;\n\n      } else {\n\n        cart.push({\n\n          id:\n            \"solar-glasses\",\n\n          name:\n            \"Solar Eclipse Glasses\",\n\n          quantity:\n            quantity\n\n        });\n\n      }\n\n\n      saveCart();\n      openCart();\n\n    }\n\n\n    function changeQuantity(\n      index,\n      amount\n    ) {\n\n      if (!cart[index]) {\n        return;\n      }\n\n\n      cart[index].quantity +=\n        amount;\n\n\n      if (\n        cart[index].quantity <= 0\n      ) {\n\n        cart.splice(\n          index,\n          1\n        );\n\n      }\n\n\n      saveCart();\n\n    }\n\n\n    function removeItem(index) {\n\n      cart.splice(\n        index,\n        1\n      );\n\n      saveCart();\n\n    }\n\n\n    function renderCart() {\n\n      const container =\n        document.getElementById(\n          \"cartItems\"\n        );\n\n\n      const count =\n        document.getElementById(\n          \"cartCount\"\n        );\n\n\n      const totalElement =\n        document.getElementById(\n          \"cartTotal\"\n        );\n\n\n      count.textContent =\n        getCartCount();\n\n\n      if (!cart.length) {\n\n        container.innerHTML =\n          '<div class=\"cart-empty\">' +\n            'Your cart is empty.' +\n          '</div>';\n\n\n        totalElement.textContent =\n          \"€0.00\";\n\n\n        return;\n\n      }\n\n\n      let total = 0;\n      let cartHTML = \"\";\n\n\n      cart.forEach(\n        (\n          item,\n          index\n        ) => {\n\n\n          const unitPrice =\n            getUnitPrice(\n              item.quantity\n            );\n\n\n          const itemTotal =\n            unitPrice *\n            item.quantity;\n\n\n          total +=\n            itemTotal;\n\n\n          cartHTML +=\n\n            '<div class=\"cart-item\">' +\n\n              '<div>' +\n\n                '<div class=\"cart-item-name\">' +\n                  escapeHTML(\n                    item.name\n                  ) +\n                '</div>' +\n\n                '<div class=\"cart-item-detail\">' +\n                  '€' +\n                  unitPrice.toFixed(2) +\n                  ' / pair' +\n                '</div>' +\n\n                '<div class=\"cart-controls\">' +\n\n                  '<button ' +\n                    'class=\"cart-control\" ' +\n                    'onclick=\"changeQuantity(' +\n                      index +\n                      ', -1)\"' +\n                  '>−</button>' +\n\n                  '<span>' +\n                    item.quantity +\n                  '</span>' +\n\n                  '<button ' +\n                    'class=\"cart-control\" ' +\n                    'onclick=\"changeQuantity(' +\n                      index +\n                      ', 1)\"' +\n                  '>+</button>' +\n\n                  '<button ' +\n                    'class=\"remove-item\" ' +\n                    'onclick=\"removeItem(' +\n                      index +\n                    ')\"' +\n                  '>' +\n                    'Remove' +\n                  '</button>' +\n\n                '</div>' +\n\n              '</div>' +\n\n              '<div class=\"cart-item-price\">' +\n                '€' +\n                itemTotal.toFixed(2) +\n              '</div>' +\n\n            '</div>';\n\n        }\n      );\n\n\n      container.innerHTML =\n        cartHTML;\n\n\n      totalElement.textContent =\n        \"€\" +\n        total.toFixed(2);\n\n    }\n\n\n    function escapeHTML(value) {\n\n      return String(value)\n\n        .replace(\n          /&/g,\n          \"&amp;\"\n        )\n\n        .replace(\n          /</g,\n          \"&lt;\"\n        )\n\n        .replace(\n          />/g,\n          \"&gt;\"\n        )\n\n        .replace(\n          /\"/g,\n          \"&quot;\"\n        )\n\n        .replace(\n          /'/g,\n          \"&#039;\"\n        );\n\n    }\n\n\n    function openCart() {\n\n      document\n        .getElementById(\n          \"cartDrawer\"\n        )\n        .classList.add(\n          \"open\"\n        );\n\n\n      document\n        .getElementById(\n          \"cartOverlay\"\n        )\n        .classList.add(\n          \"open\"\n        );\n\n\n      document.body.style.overflow =\n        \"hidden\";\n\n    }\n\n\n    function closeCart() {\n\n      document\n        .getElementById(\n          \"cartDrawer\"\n        )\n        .classList.remove(\n          \"open\"\n        );\n\n\n      document\n        .getElementById(\n          \"cartOverlay\"\n        )\n        .classList.remove(\n          \"open\"\n        );\n\n\n      document.body.style.overflow =\n        \"\";\n\n    }\n\n\n    /*\n    ============================================================\n    EMAIL CHECKOUT\n    ============================================================\n    */\n\n    function checkout() {\n\n      if (!cart.length) {\n        return;\n      }\n\n\n      let total = 0;\n      let orderLines = \"\";\n\n\n      cart.forEach(\n        item => {\n\n          const unitPrice =\n            getUnitPrice(\n              item.quantity\n            );\n\n\n          const itemTotal =\n            unitPrice *\n            item.quantity;\n\n\n          total +=\n            itemTotal;\n\n\n          orderLines +=\n\n            item.name +\n            \" — \" +\n            item.quantity +\n            \" pairs — €\" +\n            itemTotal.toFixed(2) +\n            \"\\n\";\n\n        }\n      );\n\n\n      const subject =\n        encodeURIComponent(\n          \"EclipseGlasses.eu order enquiry\"\n        );\n\n\n      const body =\n        encodeURIComponent(\n\n          \"Hello,\\n\\n\" +\n\n          \"I would like to order the following:\\n\\n\" +\n\n          orderLines +\n\n          \"\\n\" +\n\n          \"Product total: €\" +\n\n          total.toFixed(2) +\n\n          \"\\n\\n\" +\n\n          \"Please let me know the shipping cost and the next steps.\\n\\n\" +\n\n          \"Thank you.\"\n\n        );\n\n\n      window.location.href =\n        \"mailto:orders@eclipseglasses.eu\" +\n        \"?subject=\" +\n        subject +\n        \"&body=\" +\n        body;\n\n    }\n\n\n    /*\n    ============================================================\n    PRICE SELECTION\n    ================