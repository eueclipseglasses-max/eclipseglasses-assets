const CSS = "/* EclipseGlasses layout — same palette and type, quieter composition. */\n\n.eg {\n  color: var(--color-cream);\n  font-family: var(--font-sans);\n  line-height: 1.6;\n}\n\n.eg * {\n  box-sizing: border-box;\n}\n\n.eg a {\n  color: inherit;\n  text-decoration: none;\n}\n\n.eg button,\n.eg input,\n.eg select,\n.eg textarea {\n  font: inherit;\n}\n\n.eg button {\n  cursor: pointer;\n}\n\n.eg img {\n  outline: 1px solid rgb(255 255 255 / 0.08);\n  outline-offset: -1px;\n}\n\n.eg .container {\n  width: min(72rem, calc(100% - 2.5rem));\n  margin: 0 auto;\n}\n\n.eg section {\n  scroll-margin-top: 5.5rem;\n}\n\n/* ---------- nav ---------- */\n\n.eg .nav {\n  position: fixed;\n  inset: 0 0 auto 0;\n  z-index: 100;\n  background: rgb(8 8 8 / 0.78);\n  border-bottom: 1px solid var(--color-line-soft);\n  backdrop-filter: blur(18px);\n  -webkit-backdrop-filter: blur(18px);\n}\n\n.eg .nav-inner {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  height: 4.5rem;\n  gap: 1.25rem;\n}\n\n.eg .logo {\n  font-family: var(--font-display);\n  font-weight: 800;\n  letter-spacing: -0.045em;\n  font-size: 1.05rem;\n  white-space: nowrap;\n}\n\n.eg .logo span {\n  color: var(--color-gold);\n}\n\n.eg .nav-links {\n  display: flex;\n  align-items: center;\n  gap: 2rem;\n  margin-left: auto;\n}\n\n.eg .nav-links a {\n  color: #bdb9b0;\n  font-size: 0.84rem;\n  font-weight: 500;\n}\n\n.eg .nav-links a:hover {\n  color: var(--color-cream);\n}\n\n.eg .nav-right {\n  display: flex;\n  align-items: center;\n  gap: 0.6rem;\n}\n\n.eg .nav-toggle {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n}\n\n.eg .nav-burger {\n  display: none;\n  width: 2.75rem;\n  height: 2.75rem;\n  align-items: center;\n  justify-content: center;\n  border-radius: var(--radius-control);\n  box-shadow: var(--shadow-ring);\n  cursor: pointer;\n}\n\n.eg .nav-burger span,\n.eg .nav-burger span::before,\n.eg .