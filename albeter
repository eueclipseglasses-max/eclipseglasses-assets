 const inBeeld=new Set(),extra=new Set();
 if(z>=LIJN_MIN_ZOOM)for(const [k,bb] of Object.entries(idx.tegels||{}))if(!(bb[2]<w||bb[0]>e||bb[3]<s||bb[1]>n))inBeeld.add(k);
 for(const [rid,soort] of focus)if(soort!=='tijdelijk')for(const k of (idx.lijnen[rid]&&idx.lijnen[rid].t)||[])if(!inBeeld.has(k))extra.add(k);
 const tegels=[...inBeeld,...extra];let volgende=0;
 await Promise.all(Array.from({length:Math.min(6,tegels.length)},async()=>{while(volgende<tegels.length){await laadTegel(tegels[volgende++]);}}));
 if(versie!==lijnVersie||!map.getSource('golem-lijnen'))return;
 const bekend=new Set(allRoutes.map(r=>r.route_id)),net=[],stukken=[];
