  <script>


    const PRICE_TIERS = [

      {
        min: 50,
        price: 119.95 / 50
      },

      {
        min: 25,
        price: 69.95 / 25
      },

      {
        min: 10,
        price: 34.95 / 10
      },

      {
        min: 5,
        price: 19.95 / 5
      },

      {
        min: 1,
        price: 4.95
      }

    ];


    let cart =
      JSON.parse(
        localStorage.getItem(
          "eclipse_cart"
        ) || "[]"
      );


    function getUnitPrice(quantity) {

      for (
        const tier of PRICE_TIERS
      ) {

        if (
          quantity >= tier.min
        ) {

          return tier.price;

        }

      }

      return 4.95;

    }


    function getCartCount() {

      return cart.reduce(
        (
          sum,
          item
        ) =>
          sum +
          item.quantity,
        0
      );

    }


    function saveCart() {

      localStorage.setItem(
        "eclipse_cart",
        JSON.stringify(cart)
      );

      renderCart();

    }


    function addToCart() {

      const quantityInput =
        document.getElementById(
          "quantity"
        );


      let quantity =
        parseInt(
          quantityInput.value,
          10
        );


      if (
        !quantity ||
        quantity < 1
      ) {

        quantity = 1;

      }


      const existing =
        cart.find(
          item =>
            item.id ===
            "solar-glasses"
        );


      if (existing) {

        existing.quantity +=
          quantity;

      } else {

        cart.push({

          id:
            "solar-glasses",

          name:
            "Solar Eclipse Glasses",

          quantity:
            quantity

        });

      }


      saveCart();
      openCart();

    }


    function changeQuantity(
      index,
      amount
    ) {

      if (!cart[index]) {
        return;
      }


      cart[index].quantity +=
        amount;


      if (
        cart[index].quantity <= 0
      ) {

        cart.splice(
          index,
          1
        );

      }


      saveCart();

    }


    function removeItem(index) {

      cart.splice(
        index,
        1
      );

      saveCart();

    }


    function renderCart() {

      const container =
        document.getElementById(
          "cartItems"
        );


      const count =
        document.getElementById(
          "cartCount"
        );


      const totalElement =
        document.getElementById(
          "cartTotal"
        );


      count.textContent =
        getCartCount();


      if (!cart.length) {

        container.innerHTML =
          '<div class="cart-empty">' +
            'Your cart is empty.' +
          '</div>';


        totalElement.textContent =
          "€0.00";


        return;

      }


      let total = 0;
      let cartHTML = "";


      cart.forEach(
        (
          item,
          index
        ) => {


          const unitPrice =
            getUnitPrice(
              item.quantity
            );


          const itemTotal =
            unitPrice *
            item.quantity;


          total +=
            itemTotal;


          cartHTML +=

            '<div class="cart-item">' +

              '<div>' +

                '<div class="cart-item-name">' +
                  escapeHTML(
                    item.name
                  ) +
                '</div>' +

                '<div class="cart-item-detail">' +
                  '€' +
                  unitPrice.toFixed(2) +
                  ' / pair' +
                '</div>' +

                '<div class="cart-controls">' +

                  '<button ' +
                    'class="cart-control" ' +
                    'onclick="changeQuantity(' +
                      index +
                      ', -1)"' +
                  '>−</button>' +

                  '<span>' +
                    item.quantity +
                  '</span>' +

                  '<button ' +
                    'class="cart-control" ' +
                    'onclick="changeQuantity(' +
                      index +
                      ', 1)"' +
                  '>+</button>' +

                  '<button ' +
                    'class="remove-item" ' +
                    'onclick="removeItem(' +
                      index +
                    ')"' +
                  '>' +
                    'Remove' +
                  '</button>' +

                '</div>' +

              '</div>' +

              '<div class="cart-item-price">' +
                '€' +
                itemTotal.toFixed(2) +
              '</div>' +

            '</div>';

        }
      );


      container.innerHTML =
        cartHTML;


      totalElement.textContent =
        "€" +
        total.toFixed(2);

    }


    function escapeHTML(value) {

      return String(value)

        .replace(
          /&/g,
          "&amp;"
        )

        .replace(
          /</g,
          "&lt;"
        )

        .replace(
          />/g,
          "&gt;"
        )

        .replace(
          /"/g,
          "&quot;"
        )

        .replace(
          /'/g,
          "&#039;"
        );

    }


    function openCart() {

      document
        .getElementById(
          "cartDrawer"
        )
        .classList.add(
          "open"
        );


      document
        .getElementById(
          "cartOverlay"
        )
        .classList.add(
          "open"
        );


      document.body.style.overflow =
        "hidden";

    }


    function closeCart() {

      document
        .getElementById(
          "cartDrawer"
        )
        .classList.remove(
          "open"
        );


      document
        .getElementById(
          "cartOverlay"
        )
        .classList.remove(
          "open"
        );


      document.body.style.overflow =
        "";

    }


    /*
    ============================================================
    EMAIL CHECKOUT
    ============================================================
    */

    function checkout() {

      if (!cart.length) {
        return;
      }


      let total = 0;
      let orderLines = "";


      cart.forEach(
        item => {

          const unitPrice =
            getUnitPrice(
              item.quantity
            );


          const itemTotal =
            unitPrice *
            item.quantity;


          total +=
            itemTotal;


          orderLines +=

            item.name +
            " — " +
            item.quantity +
            " pairs — €" +
            itemTotal.toFixed(2) +
            "\\n";

        }
      );


      const subject =
        encodeURIComponent(
          "EclipseGlasses.eu order enquiry"
        );


      const body =
        encodeURIComponent(

          "Hello,\\n\\n" +

          "I would like to order the following:\\n\\n" +

          orderLines +

          "\\n" +

          "Product total: €" +

          total.toFixed(2) +

          "\\n\\n" +

          "Please let me know the shipping cost and the next steps.\\n\\n" +

          "Thank you."

        );


      window.location.href =
        "mailto:orders@eclipseglasses.eu" +
        "?subject=" +
        subject +
        "&body=" +
        body;

    }


    /*
    ============================================================
    PRICE SELECTION
    ============================================================
    */

    document
      .querySelectorAll(
        ".price-option"
      )
      .forEach(
        option => {

          option.addEventListener(
            "click",
            () => {


              document
                .querySelectorAll(
                  ".price-option"
                )
                .forEach(
                  item => {

                    item.classList.remove(
                      "active"
                    );

                  }
                );


              option.classList.add(
                "active"
              );


              document
                .getElementById(
                  "quantity"
                )
                .value =
                option.dataset.qty;

            }
          );

        }
      );


    /*
    ============================================================
    FAQ
    ============================================================
    */

    document
      .querySelectorAll(
        ".faq-question"
      )
      .forEach(
        button => {

          button.addEventListener(
            "click",
            () => {


              const item =
                button.parentElement;


              const answer =
                item.querySelector(
                  ".faq-answer"
                );


              const isOpen =
                item.classList.contains(
                  "open"
                );


              document
                .querySelectorAll(
                  ".faq-item.open"
                )
                .forEach(
                  openItem => {

                    openItem.classList.remove(
                      "open"
                    );


                    openItem
                      .querySelector(
                        ".faq-answer"
                      )
                      .style.maxHeight =
                      null;

                  }
                );


              if (!isOpen) {

                item.classList.add(
                  "open"
                );


                answer.style.maxHeight =
                  answer.scrollHeight +
                  "px";

              }

            }
          );

        }
      );


    /*
    ============================================================
    BULK QUOTE REQUEST
    ============================================================
    */

    async function submitBulk(
      event
    ) {

      event.preventDefault();


      const form =
        event.target;


      const button =
        document.getElementById(
          "quoteSubmitButton"
        );


      const status =
        document.getElementById(
          "quoteStatus"
        );


      const name =
        document
          .getElementById(
            "bulkName"
          )
          .value
          .trim();


      const email =
        document
          .getElementById(
            "bulkEmail"
          )
          .value
          .trim();


      const quantity =
        document
          .getElementById(
            "bulkQuantity"
          )
          .value
          .trim();


      const message =
        document
          .getElementById(
            "bulkMessage"
          )
          .value
          .trim();


      const website =
        document
          .getElementById(
            "bulkWebsite"
          )
          .value
          .trim();


      status.classList.remove(
        "show"
      );


      status.classList.remove(
        "error"
      );


      if (
        !name ||
        !email ||
        !quantity
      ) {

        return;

      }


      button.disabled =
        true;


      button.style.opacity =
        "0.65";


      const originalButtonText =
        button.innerHTML;


      button.innerHTML =
        "<span>Sending...</span>";


      try {


        const response =
          await fetch(
            "/api/quote",
            {

              method:
                "POST",

              headers: {

                "Content-Type":
                  "application/json"

              },

              body:
                JSON.stringify({

                  name:
                    name,

                  email:
                    email,

                  quantity:
                    quantity,

                  message:
                    message,

                  website:
                    website

                })

            }
          );


        const result =
          await response.json();


        if (
          !response.ok ||
          !result.success
        ) {

          throw new Error(
            result.error ||
            "Something went wrong."
          );

        }


        status.innerHTML =

          "<strong>Quote request received.</strong><br>" +

          "Your reference number is <strong>" +

          escapeHTML(
            result.quoteNumber
          ) +

          "</strong>. " +

          "We'll get back to you as soon as possible.";


        status.classList.add(
          "show"
        );


        form.reset();


        document
          .getElementById(
            "bulkQuantity"
          )
          .value =
          "";


      } catch (error) {


        console.error(
          "Quote submission error:",
          error
        );


        status.textContent =
          error.message ||
          "Something went wrong. Please try again.";


        status.classList.add(
          "show"
        );


        status.classList.add(
          "error"
        );


      } finally {


        button.disabled =
          false;


        button.style.opacity =
          "";


        button.innerHTML =
          originalButtonText;

      }

    }


