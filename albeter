 if(!lijnBezig.has(k))lijnBezig.set(k,fetch('/kaartdata/net/'+k+'.json').then(r=>r.ok?r.json():null).catch(()=>null).then(d=>{const f=d&&Array.isArray(d.f)?d.f.map(x=>({g:x[0],r:x[1],c:decodeerLijn(x[2])})):null;lijnTegels.set(k,f);lijnBezig.delete(k);return f;}));
