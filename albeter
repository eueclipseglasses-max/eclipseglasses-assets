    function checkout() {

      if (!cart.length) {
        return;
      }


      let total = 0;
      let orderLines = "";


      cart.forEach(
        item => {

          const unitPrice =
            getUnitPrice(
              item.quantity
            );


          const itemTotal =
            unitPrice *
            item.quantity;


          total +=
            itemTotal;


          orderLines +=

            item.name +
            " — " +
            item.quantity +
            " " + ((extraTranslations[document.documentElement.lang] || extraTranslations.en).cartItem) + " — €" +
            itemTotal.toFixed(2) +
            "\n";

        }
      );


      const subject =
        encodeURIComponent(
          (extraTranslations[document.documentElement.lang] || extraTranslations.en).orderSubject
        );


      const body =
        encodeURIComponent(

          (extraTranslations[document.documentElement.lang] || extraTranslations.en).orderIntro +

          orderLines +

          "\n" +

          (extraTranslations[document.documentElement.lang] || extraTranslations.en).orderProductTotal + " €" +

          total.toFixed(2) +

          "\n\n" +

          (extraTranslations[document.documentElement.lang] || extraTranslations.en).orderShipping + "\n\n" +

          (extraTranslations[document.documentElement.lang] || extraTranslations.en).orderThanks

        );


      window.location.href =
        "mailto:orders@eclipseglasses.eu" +
        "?subject=" +
        subject +
        "&body=" +
        body;

    }


