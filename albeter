async function recordPageView(request,env,path){
  if(!env.DB)return {};
  await ensureAnalyticsTables(env);
  let visitor=analyticsCookieValue(request,"golem_visitor");
  const newVisitor=!/^[a-f0-9-]{36}$/i.test(visitor);
  if(newVisitor)visitor=crypto.randomUUID();
  // Een sessie is een periode van 30 minuten; er wordt geen apart sessie-ID-cookie geplaatst.
  const session=visitor+":"+Math.floor(Date.now()/1800000);
  const ua=request.headers.get("User-Agent")||"";
  const agent=analyticsAgent(ua);
  let referrer="";
  try{const ref=request.headers.get("Referer");if(ref){const host=new URL(ref).hostname.toLowerCase();if(host&&!host.endsWith("degolem.be"))referrer=host;}}catch(e){}
  const cf=request.cf||{};
  await env.DB.prepare(`INSERT INTO analytics_events
    (id,visitor_key,session_key,created_at,path,country,region,city,referrer,device,browser,os)
    VALUES(?,?,?,?,?,?,?,?,?,?,?,?)`).bind(
      crypto.randomUUID(),await hashText(visitor),await hashText(session),new Date().toISOString(),
      String(path||"/").slice(0,180),String(cf.country||"Onbekend").slice(0,80),
      String(cf.region||"").slice(0,100),String(cf.city||"Onbekend").slice(0,100),
      referrer.slice(0,160),agent.device,agent.browser,agent.os
    ).run();
  await env.DB.prepare("DELETE FROM analytics_events WHERE created_at < ?").bind(new Date(Date.now()-400*86400000).toISOString()).run();
  return {"Set-Cookie":cookie("golem_visitor",visitor,365*86400)};
}
