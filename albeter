    /* EclipseGlasses ambient glow cursor — desktop only */
    @media (pointer: fine) and (prefers-reduced-motion: no-preference) {
      body.eg-custom-cursor,
      body.eg-custom-cursor a,
      body.eg-custom-cursor button,
      body.eg-custom-cursor input,
      body.eg-custom-cursor select,
      body.eg-custom-cursor textarea,
      body.eg-custom-cursor summary,
      body.eg-custom-cursor [role="button"] {
        cursor: none !important;
      }

      .eg-cursor {
        --eg-cursor-rgb: 218, 181, 105;
        position: fixed;
        left: 0;
        top: 0;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        pointer-events: none;
        z-index: 99999;
        transform: translate(-50%, -50%);
        opacity: 0;
        background: rgba(var(--eg-cursor-rgb), .96);
        border: 1px solid rgba(255, 244, 215, .95);
        box-shadow:
          0 0 8px rgba(var(--eg-cursor-rgb), .85),
          0 0 20px rgba(var(--eg-cursor-rgb), .42),
          0 0 42px rgba(var(--eg-cursor-rgb), .16);
        transition:
          width .24s cubic-bezier(.2,.8,.2,1),
          height .24s cubic-bezier(.2,.8,.2,1),
          background-color .24s ease,
          border-color .24s ease,
          box-shadow .24s ease,
          opacity .18s ease;
        will-change: left, top, width, height;
      }

      .eg-cursor::before {
        content: "";
        position: absolute;
        inset: -13px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(var(--eg-cursor-rgb), .22) 0%, rgba(var(--eg-cursor-rgb), .10) 34%, rgba(var(--eg-cursor-rgb), 0) 72%);
        filter: blur(2px);
        transform: scale(.82);
        transition: transform .28s ease, opacity .28s ease;
        opacity: .8;
      }

      .eg-cursor::after {
        content: "";
        position: absolute;
        inset: 4px;
        border-radius: 50%;
        background: #fff9e9;
        box-shadow: 0 0 7px rgba(255,255,255,.75);
        transition: inset .24s ease, background-color .24s ease;
      }

      .eg-cursor.is-visible { opacity: 1; }

      .eg-cursor.is-hovering {
        width: 34px;
        height: 34px;
        background: rgba(var(--eg-cursor-rgb), .15);
        border-color: rgba(var(--eg-cursor-rgb), .95);
        box-shadow:
          0 0 10px rgba(var(--eg-cursor-rgb), .7),
          0 0 28px rgba(var(--eg-cursor-rgb), .5),
          0 0 60px rgba(var(--eg-cursor-rgb), .24),
          inset 0 0 12px rgba(var(--eg-cursor-rgb), .12);
      }

      .eg-cursor.is-hovering::before {
        inset: -24px;
        transform: scale(1.12);
        opacity: 1;
      }

      .eg-cursor.is-hovering::after {
        inset: 12px;
        background: rgb(var(--eg-cursor-rgb));
      }

      .eg-cursor.is-link { --eg-cursor-rgb: 226, 196, 127; }
      .eg-cursor.is-button { --eg-cursor-rgb: 255, 231, 174; }
      .eg-cursor.is-field { --eg-cursor-rgb: 245, 239, 220; }

      .eg-cursor.is-pressing {
        width: 23px;
        height: 23px;
        box-shadow:
          0 0 7px rgba(var(--eg-cursor-rgb), .9),
          0 0 18px rgba(var(--eg-cursor-rgb), .55);
      }

      .eg-cursor.is-pressing::before {
        inset: -8px;
        opacity: .55;
      }
    }

