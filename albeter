async function rateLimitCommunity(env,key,limit,windowMs) {
  const now=new Date().toISOString();
  await env.DB.prepare("DELETE FROM community_rate_limits WHERE created_at < ?").bind(new Date(Date.now()-24*3600000).toISOString()).run();
  const row=await env.DB.prepare("SELECT COUNT(*) AS n FROM community_rate_limits WHERE rate_key=? AND created_at > ?").bind(key,new Date(Date.now()-windowMs).toISOString()).first();
  if(Number(row?.n||0)>=limit)return false;
