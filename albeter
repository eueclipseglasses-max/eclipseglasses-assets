      uit[richting]={status:r.status,fout:r.fout||null,velden:r.data?Object.keys(r.data):[],ritten:ritten.length,voorbeeld:ritten[0]?{rit:ritten[0].rit,haltes:ritten[0].h.slice(0,4).map(h=>[h[0],new Date(h[1]).toISOString(),h[2]])}:null};
