let mijnLocatieMarker=null,mijnLocatieWatch=null,mijnLocatieLaatste=null;
function volgMijnLocatie(centreer){
 if(!navigator.geolocation)return;
 if(centreer&&mijnLocatieLaatste)map.flyTo({center:mijnLocatieLaatste,zoom:Math.max(map.getZoom(),15)});
