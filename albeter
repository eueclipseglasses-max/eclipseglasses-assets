 for(const id of ['golem-lijnen','golem-lijnen-rand','golem-controle-gloed'])map.setPaintProperty(id,'line-offset',offset);
 map.setPaintProperty('golem-lijnen','line-width',perZoom((s,w)=>['max',1,['-',s,w>3?1:0.6]]));
 map.setPaintProperty('golem-lijnen-rand','line-width',perZoom((s,w)=>['+',s,w>3?2:1.4]));
 map.setPaintProperty('golem-controle-gloed','line-width',perZoom(s=>['+',['*',s,2.5],6]));
