    function applyLanguage(
      language
    ) {

      const dictionary =
        translations[language] ||
        translations.en;


      document
        .querySelectorAll(
          "[data-i18n]"
        )
        .forEach(
          element => {

            const key =
              element.dataset.i18n;


            if (
              dictionary[key]
            ) {

              element.textContent =
                dictionary[key];

            }

          }
        );


      localStorage.setItem(
        "eclipse_language",
        language
      );

    }


    document
      .getElementById(
        "language"
      )
      .addEventListener(
        "change",
        event => {

          applyLanguage(
            event.target.value
          );

        }
      );


    const savedLanguage =
      localStorage.getItem(
        "eclipse_language"
      ) ||
      "en";


    document
      .getElementById(
        "language"
      )
      .value =
      savedLanguage;


    applyLanguage(
      savedLanguage
    );


    // Ambient gold glow cursor. It changes glow/size according to the hovered control.
    if (
      window.matchMedia &&
      window.matchMedia("(pointer: fine) and (prefers-reduced-motion: no-preference)").matches
    ) {
      const egCursor = document.createElement("div");
      egCursor.className = "eg-cursor";
      egCursor.setAttribute("aria-hidden", "true");
      document.body.appendChild(egCursor);
      document.body.classList.add("eg-custom-cursor");

      const interactiveSelector = "a, button, input, select, textarea, summary, [role='button'], .cart-button, .quantity-button";
      let cursorVisible = false;

      const moveCursor = (event) => {
        egCursor.style.left = event.clientX + "px";
        egCursor.style.top = event.clientY + "px";
        if (!cursorVisible) {
          egCursor.classList.add("is-visible");
          cursorVisible = true;
        }
      };

      const setHoverTarget = (target) => {
        const element = target && target.closest ? target.closest(interactiveSelector) : null;
        egCursor.classList.remove("is-hovering", "is-link", "is-button", "is-field");
        if (!element) return;
        egCursor.classList.add("is-hovering");
        if (element.matches("button, [role='button'], .cart-button, .quantity-button")) {
          egCursor.classList.add("is-button");
        } else if (element.matches("input, select, textarea")) {
          egCursor.classList.add("is-field");
        } else {
          egCursor.classList.add("is-link");
        }
      };

      document.addEventListener("pointermove", moveCursor, { passive: true });
      document.addEventListener("pointerover", (event) => setHoverTarget(event.target));
      document.addEventListener("pointerout", (event) => {
        const leaving = event.target && event.target.closest ? event.target.closest(interactiveSelector) : null;
        const entering = event.relatedTarget && event.relatedTarget.closest ? event.relatedTarget.closest(interactiveSelector) : null;
        if (leaving !== entering) setHoverTarget(event.relatedTarget);
      });
      document.addEventListener("pointerdown", () => egCursor.classList.add("is-pressing"));
      document.addEventListener("pointerup", () => egCursor.classList.remove("is-pressing"));
      document.addEventListener("pointerleave", () => {
        egCursor.classList.remove("is-visible");
        cursorVisible = false;
      });
      document.addEventListener("pointerenter", () => {
        egCursor.classList.add("is-visible");
        cursorVisible = true;
      });
    }

    // Reveal gallery and key sections only when they enter view; fail open if unsupported.
    try {
      const revealTargets = document.querySelectorAll(".visual-story-heading, .visual-card");
      if ("IntersectionObserver" in window && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.body.classList.add("motion-ready");
        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12, rootMargin: "0px 0px -24px 0px" });
        revealTargets.forEach(target => revealObserver.observe(target));
      }
    } catch (error) {
      document.body.classList.remove("motion-ready");
    }


    function updateEclipseCountdown() {
      const counter = document.getElementById("eclipseDays");
      if (!counter) return;
      const days = Math.max(0, Math.ceil((new Date(2027, 7, 2).getTime() - Date.now()) / 86400000));
      counter.textContent = new Intl.NumberFormat(document.documentElement.lang || "en").format(days);
    }
    updateEclipseCountdown();
    window.setInterval(updateEclipseCountdown, 60000);

