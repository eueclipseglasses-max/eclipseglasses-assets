}
$('routeSelect').addEventListener('change',e=>loadStops(e.target.value).catch(err=>{$('stopSelect').innerHTML='<option value="">Haltes konden niet laden</option>';$('reportMessage').textContent=err.message;}));
$('gpsButton').addEventListener('click',()=>{
 if(!$('stopSelect').value){$('gpsMessage').textContent='Kies eerst een lijn en halte.';return;}
 if(!navigator.geolocation){$('gpsMessage').textContent='Je browser ondersteunt geen GPS.';return;}
 $('gpsMessage').textContent='Locatie wordt gecontroleerd...';
 navigator.geolocation.getCurrentPosition(pos=>{
  gpsCheck={latitude:pos.coords.latitude,longitude:pos.coords.longitude};
  $('gpsMessage').textContent='GPS-locatie ontvangen. De server controleert of je dicht bij de gekozen halte bent.';
 },err=>{$('gpsMessage').textContent='Locatie kon niet worden gecontroleerd. Controleer de locatietoestemming en probeer opnieuw.';}, {enableHighAccuracy:true,timeout:15000,maximumAge:0});
});
async function loadReports(){
 const data=await api('/api/reports');
 reportMarkers.forEach(marker=>marker.remove());
 reportMarkers.length=0;
 $('countActive').textContent=data.reports.length;
 const today=new Date().toLocaleDateString('en-CA');
 $('countToday').textContent=data.reports.filter(r=>r.created_at.slice(0,10)===today).length;
 $('reportsList').innerHTML=data.reports.slice(0,12).map(r=>reportCard(r)).join('')||'<p class="muted">Nog geen meldingen geregistreerd.</p>';
 for(const r of data.reports){
  const el=document.createElement('div');el.className='report-marker';el.setAttribute('aria-label','Vervoersmelding');
  const popup=new maplibregl.Popup({offset:14}).setHTML('<strong>'+esc('Lijn '+(r.route_short_name||'—')+' · '+(r.stop_name||r.location_name||'Halte'))+'</strong><br><small>'+esc(formatDate(r.observed_at))+'</small><br><small>'+(r.gps_confirmed?'GPS bevestigd':'GPS niet bevestigd')+'</small>');
  const marker=new maplibregl.Marker({element:el,anchor:'center'}).setLngLat([Number(r.longitude),Number(r.latitude)]).setPopup(popup).addTo(map);
  reportMarkers.push(marker);
 }
}
$('newReport').addEventListener('submit',async e=>{
 e.preventDefault();$('reportMessage').textContent='Melding wordt ingediend...';
 try{
  if(!$('routeSelect').value || !$('stopSelect').value) throw new Error('Kies eerst een lijn en halte.');
  await api('/api/reports',{method:'POST',body:JSON.stringify({
   route_id:$('routeSelect').value,stop_id:$('stopSelect').value,
   gps_latitude:gpsCheck?.latitude ?? null,gps_longitude:gpsCheck?.longitude ?? null,
   observed_at:new Date($('observed').value).toISOString()
  })});
  $('reportMessage').textContent='Melding ontvangen en wacht op controle.';
  $('newReport').reset();gpsCheck=null;$('stopSelect').disabled=true;$('stopSelect').innerHTML='<option value="">Kies eerst een lijn</option>';loadRoutes().catch(()=>{});
 }catch(err){$('reportMessage').textContent=err.message;}
});
async function loadPending(){
 const data=await api('/api/admin/pending');
 $('pendingList').innerHTML=data.reports.map(r=>
  reportCard(r,true)
 ).join('')||'<p class="muted">Geen openstaande meldingen.</p>';
}
$('pendingList').addEventListener('click',async e=>{
 const button=e.target.closest('button[data-id]');
 if(!button)return;
 try{
  await api('/api/admin/moderate',{
   method:'POST',
   body:JSON.stringify({
    id:button.dataset.id,
    status:button.dataset.status
   })
  });
  await loadPending();
  await loadReports();
 }catch(error){
  alert(error.message);
 }
});
async function startApp(){
 const data=await api('/api/me');$('authScreen').classList.add('hidden');$('appScreen').classList.remove('hidden');$('authButton').classList.remove('hidden');
 $('authButton').textContent='Uitloggen';$('reportForm').classList.remove('hidden');$('reportCta').textContent='+ Nieuwe melding';$('reportCta').onclick=()=>$('reportForm').scrollIntoView({behavior:'smooth'});
 $('userRole').textContent=data.user.role==='admin'?'Beheerder':'Gebruiker';if(data.user.role==='admin')$('adminPanel').classList.remove('hidden');
 initMap();setTimeout(()=>map.resize(),100);await loadRoutes();await loadReports();if(data.user.role==='admin')await loadPending();
}
async function startPublicApp(){
 $('authScreen').classList.add('hidden');$('appScreen').classList.remove('hidden');$('authButton').classList.remove('hidden');$('authButton').textContent='Inloggen';
 $('reportForm').classList.add('hidden');$('adminPanel').classList.add('hidden');$('reportCta').textContent='Inloggen om te melden';$('reportCta').onclick=openAuth;
 $('userRole').textContent='Openbaar';initMap();setTimeout(()=>map.resize(),100);await loadReports();
}
$('authButton').classList.add('hidden');
$('observed').value=new Date(Date.now()-new Date().getTimezoneOffset()*60000).toISOString().slice(0,16);
api('/api/me').then(startApp).catch(()=>startPublicApp().catch(err=>console.error('Dashboard:',err)));
if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('/sw.js')
      .catch(error => console.error('Service worker:', error));
  });
}
</script>
