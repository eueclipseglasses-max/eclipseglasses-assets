async function handleApi(request, env) {
  const url = new URL(request.url);
  const path = url.pathname;
  const method = request.method;
  if(path.startsWith("/api/reports")||path.startsWith("/api/admin")) await ensureCommunityTables(env);
  if(path.startsWith("/api/cities")) await ensureCityTables(env);

  if (method !== "GET") {
    const origin = request.headers.get("Origin");
    if (origin && origin !== url.origin) {
      return json({error:"Ongeldige oorsprong"},403);
    }
  }

  if (path === "/app-icon.png" && method === "GET") {
    const icon = await fetch("https://raw.githubusercontent.com/eueclipseglasses-max/eclipseglasses-assets/main/DEGOLEMLICHT-Photoroom.png");
    if (!icon.ok) return new Response("App-icoon niet beschikbaar", {status:502});
    return new Response(icon.body, {
      headers: {
        "Content-Type": "image/png",
        "Cache-Control": "public, max-age=86400"
      }
    });
  }

  if (path === "/manifest.webmanifest" && method === "GET") {
    return new Response(JSON.stringify({
      name: "De Golem",
      short_name: "De Golem",
      start_url: "/",
      display: "standalone",
      background_color: "#FBEED8",
      theme_color: "#FBEED8",
      icons: [
        {
          src: "/app-icon.png",
          sizes: "192x192",
          type: "image/png",
          purpose: "any"
        },
        {
          src: "/app-icon.png",
          sizes: "512x512",
          type: "image/png",
          purpose: "any"
        }
      ]
    }), {
      headers: {"Content-Type":"application/manifest+json"}
    });
  }

  if (path === "/icon.svg" && method === "GET") {
    return new Response(
      '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><rect width="512" height="512" rx="96" fill="#FBEED8"/><path d="M350 156c-26-29-59-44-101-44-91 0-153 65-153 160s62 160 153 160c43 0 79-14 105-42V264H245v59h43v38c-11 7-24 10-39 10-52 0-86-39-86-99s34-99 86-99c25 0 45 8 61 25z" fill="#493526"/></svg>',
      {headers:{"Content-Type":"image/svg+xml","Cache-Control":"public, max-age=31536000"}}
    );
  }

  if (path === "/sw.js" && method === "GET") {
    return new Response(`
      const CACHE = "degolem-shell-v23";

      self.addEventListener("install", event => {
        event.waitUntil(caches.open(CACHE).then(cache => cache.add("/")));
        self.skipWaiting();
      });

      self.addEventListener("activate", event => {
        event.waitUntil(
          caches.keys().then(keys =>
            Promise.all(keys.filter(k => k !== CACHE).map(k => caches.delete(k)))
          )
        );
        self.clients.claim();
      });

      self.addEventListener("fetch", event => {
        const url = new URL(event.request.url);
        if (url.origin !== self.location.origin) return;
        if (url.pathname.startsWith("/api/")) return;
        if (event.request.mode === "navigate") {
          event.respondWith(fetch(event.request).catch(() => caches.match("/")));
        }
      });
    `, {
      headers:{
        "Content-Type":"application/javascript",
        "Cache-Control":"no-cache"
      }
    });
  }

  if (path === "/api/auth/register" && method === "POST") {
    const body = await request.json().catch(() => null);

    if (!body || !validEmail(body.email) ||
        typeof body.password !== "string" ||
        body.password.length < 10 ||
        body.password.length > 128) {
      return json({error:"Gebruik een geldig e-mailadres en een wachtwoord van minstens 10 tekens."},400);
    }

    const email = body.email.trim().toLowerCase();

    const exists = await env.DB.prepare(
      "SELECT id FROM users WHERE email=?"
    ).bind(email).first();

    if (exists) {
      return json({error:"Dit e-mailadres is al geregistreerd."},409);
    }

    const id = randomId();
    const salt = randomId();
    const hash = salt + ":" + await passwordHash(body.password,salt);

    await env.DB.prepare(
      "INSERT INTO users(id,email,password_hash,role) VALUES(?,?,?,'user')"
    ).bind(id,email,hash).run();

    const sessionCookie = await createSession(id,env);
    return json({success:true},201,{"Set-Cookie":sessionCookie});
  }

  if (path === "/api/auth/login" && method === "POST") {
    const body = await request.json().catch(() => null);
    if (!body || String(body.email || "").trim().toLowerCase() !== "achilles.vandycke@telenet.be") {
      return json({error:"Alleen de beheerder kan tijdens het onderhoud inloggen."},403);
    }

    if (!body || !validEmail(body.email) ||
        typeof body.password !== "string") {
      return json({error:"Controleer je inloggegevens."},400);
    }

    const user = await env.DB.prepare(
      "SELECT id,password_hash FROM users WHERE email=?"
    ).bind(body.email.trim().toLowerCase()).first();

    if (!user) {
      return json({error:"E-mailadres of wachtwoord is onjuist."},401);
    }

    const [salt,stored] = user.password_hash.split(":");
    const calculated = await passwordHash(body.password,salt);

    if (calculated !== stored) {
      return json({error:"E-mailadres of wachtwoord is onjuist."},401);
    }

    const sessionCookie = await createSession(user.id,env);
    return json({success:true},200,{"Set-Cookie":sessionCookie});
  }

  if (path === "/api/auth/logout" && method === "POST") {
    const user = await currentUser(request,env);

    if (user) {
      const token = (request.headers.get("Cookie")||"")
        .split(";")
        .map(x=>x.trim())
        .find(x=>x.startsWith("radar_session="))
        ?.split("=")[1];

      if (token) {
        await env.DB.prepare(
          "DELETE FROM sessions WHERE token_hash=?"
        ).bind(await hashText(token)).run();
      }
    }

    return json({success:true},200,{
      "Set-Cookie":cookie("radar_session","",0)
    });
  }

  if (path === "/api/me" && method === "GET") {
    const user = await currentUser(request,env);
    if (!user) return json({error:"Niet ingelogd"},401);
    return json({user});
  }

  if(path==="/api/cities"&&method==="GET"){
    const now=new Date().toISOString(),since=new Date(Date.now()-30*86400000).toISOString();
    const definitions=[{id:"oostende",name:"Oostende",lat:51.2300,lon:2.9180,radius:22},{id:"brugge",name:"Brugge",lat:51.2093,lon:3.2247,radius:20},{id:"gent",name:"Gent",lat:51.0543,lon:3.7174,radius:23},{id:"antwerpen",name:"Antwerpen",lat:51.2194,lon:4.4025,radius:25}];
    const cities=[];for(const c of definitions){const dLat=c.radius/111,dLon=c.radius/(111*Math.cos(c.lat*Math.PI/180));const active=await env.DB.prepare(`SELECT COUNT(DISTINCT r.user_id) AS n FROM reports r JOIN transit_stops s ON s.stop_id=r.stop_id WHERE r.created_at>=? AND s.stop_lat BETWEEN ? AND ? AND s.stop_lon BETWEEN ? AND ?`).bind(since,c.lat-dLat,c.lat+dLat,c.lon-dLon,c.lon+dLon).first();const interest=await env.DB.prepare("SELECT COUNT(*) AS n FROM city_interest WHERE city_id=?").bind(c.id).first();cities.push({...c,activeReporters:Number(active?.n||0),interestCount:Number(interest?.n||0),available:c.id==="oostende"||Number(active?.n||0)>=20});}
    const ipCity=String(request.cf?.city||"").toLocaleLowerCase("nl-BE");const aliases={"oostende":"oostende","ostend":"oostende","brugge":"brugge","bruges":"brugge","gent":"gent","ghent":"gent","antwerpen":"antwerpen","antwerp":"antwerpen"};
    return json({cities,detectedCity:aliases[ipCity]||null,minimum:20});
  }
  if(path==="/api/cities/interest"&&method==="POST"){
    const body=await request.json().catch(()=>null);const allowed=["oostende","brugge","gent","antwerpen"];if(!body||!allowed.includes(body.city_id))return json({error:"Onbekende stad"},400);
    const ip=request.headers.get("CF-Connecting-IP")||"unknown";const voter=await hashText(ip);await env.DB.prepare("INSERT OR IGNORE INTO city_interest(city_id,voter_key,created_at) VALUES(?,?,?)").bind(body.city_id,voter,new Date().toISOString()).run();const row=await env.DB.prepare("SELECT COUNT(*) AS n FROM city_interest WHERE city_id=?").bind(body.city_id).first();return json({ok:true,interestCount:Number(row?.n||0)});
  }

  if (path === "/api/route-shapes" && method === "GET") {
    const cityId=url.searchParams.get("city")||"oostende";
    const bounds={
      oostende:[2.80,51.13,3.10,51.29],
      brugge:[3.10,51.14,3.36,51.28],
      gent:[3.60,50.98,3.84,51.12],
      antwerpen:[4.25,51.14,4.55,51.31]
    };
    const bbox=bounds[cityId]||bounds.oostende;
    const upstream=new URL("https://geo.api.vlaanderen.be/Reiswegen/ogc/features/v1/collections/Reisweg/items");
    upstream.searchParams.set("f","json");
    upstream.searchParams.set("limit","10000");
    upstream.searchParams.set("bbox",bbox.join(","));
    upstream.searchParams.set("bbox-crs","http://www.opengis.net/def/crs/OGC/1.3/CRS84");
    upstream.searchParams.set("crs","http://www.opengis.net/def/crs/OGC/1.3/CRS84");
    upstream.searchParams.set("filter","LIJN = '5'");
    upstream.searchParams.set("filter-lang","cql2-text");
    const response=await fetch(upstream.toString(),{headers:{"Accept":"application/geo+json, application/json"}});
    if(!response.ok)return json({error:"Officiële reiswegen tijdelijk niet beschikbaar",status:response.status},502);
    const source=await response.json();
    // Toon de officiële routegeometrie ongewijzigd als één doorlopende gekleurde spoorlijn.
    // Geen punt-voor-punt snapping of kunstmatige coördinaatverschuiving:
    // die veroorzaakten sprongen tussen naburige straten en zigzaglijnen.
    const features=(source.features||[]).filter(feature=>{
      const props=feature.properties||{};
      return String(props.LIJN||"").trim()==="5"&&feature.geometry;
    }).map(feature=>({
      type:"Feature",
      properties:{route_id:"line-5",color:"#C8D300",direction:String(feature.properties?.RICHTING||"")},
      geometry:feature.geometry
    }));
    return new Response(JSON.stringify({geojson:{type:"FeatureCollection",features}}),{
      headers:{"Content-Type":"application/json; charset=utf-8","Cache-Control":"no-store, no-cache, must-revalidate"}
    });
  }

  if (path === "/api/routes" && method === "GET") {
    const cityId=url.searchParams.get('city');const defs={oostende:[51.23,2.918,22],brugge:[51.2093,3.2247,20],gent:[51.0543,3.7174,23],antwerpen:[51.2194,4.4025,25]};const c=defs[cityId];let result;
    if(c){const dLat=c[2]/111,dLon=c[2]/(111*Math.cos(c[0]*Math.PI/180));result=await env.DB.prepare(`SELECT DISTINCT tr.route_id,tr.route_short_name,tr.route_long_name FROM transit_routes tr JOIN route_stops rs ON rs.route_id=tr.route_id JOIN transit_stops s ON s.stop_id=rs.stop_id WHERE s.stop_lat BETWEEN ? AND ? AND s.stop_lon BETWEEN ? AND ? ORDER BY tr.route_short_name,tr.route_long_name`).bind(c[0]-dLat,c[0]+dLat,c[1]-dLon,c[1]+dLon).all();}
    else result=await env.DB.prepare(`SELECT route_id,route_short_name,route_long_name FROM transit_routes ORDER BY route_short_name,route_long_name`).all();
    return json({routes:result.results||[]});
  }

  if (path.startsWith("/api/routes/") &&
      path.endsWith("/stops") &&
      method === "GET") {

    const routeId = decodeURIComponent(
      path.slice("/api/routes/".length, -"/stops".length)
    );

    const result = await env.DB.prepare(`
      SELECT s.stop_id, s.stop_name, s.stop_lat, s.stop_lon
      FROM route_stops rs
      JOIN transit_stops s ON s.stop_id=rs.stop_id
      WHERE rs.route_id=?
      ORDER BY s.stop_name
    `).bind(routeId).all();

    return json({stops:result.results||[]});
  }

  if (path === "/api/stops" && method === "GET") {
    const result = await env.DB.prepare(`
      SELECT s.stop_id,s.stop_name,s.stop_lat,s.stop_lon,GROUP_CONCAT(DISTINCT rs.route_id) AS route_ids
      FROM transit_stops s JOIN route_stops rs ON rs.stop_id=s.stop_id
      WHERE s.stop_lat IS NOT NULL AND s.stop_lon IS NOT NULL
      GROUP BY s.stop_id,s.stop_name,s.stop_lat,s.stop_lon ORDER BY s.stop_name
    `).all();
    return json({stops:result.results||[]});
  }

  if (path === "/api/ranking" && method === "GET") {
    const user=await currentUser(request,env);
    const result=await env.DB.prepare(`
      SELECT u.id,substr(u.email,1,instr(u.email,'@')-1) AS username,COUNT(r.id) AS verified_count
      FROM users u JOIN reports r ON r.user_id=u.id
      WHERE r.status='approved' AND u.email NOT LIKE 'anonymous+%@degolem.invalid'
      GROUP BY u.id,u.email
      HAVING COUNT(r.id)>0
      ORDER BY verified_count DESC,username COLLATE NOCASE ASC
      LIMIT 100
    `).all();
    let me=null;
    if(user){
      me=await env.DB.prepare(`
        WITH scores AS (
          SELECT u.id,substr(u.email,1,instr(u.email,'@')-1) AS username,COUNT(r.id) AS verified_count
          FROM users u JOIN reports r ON r.user_id=u.id
          WHERE r.status='approved' AND u.email NOT LIKE 'anonymous+%@degolem.invalid'
          GROUP BY u.id,u.email HAVING COUNT(r.id)>0
        ), ranked AS (SELECT *,ROW_NUMBER() OVER(ORDER BY verified_count DESC,username COLLATE NOCASE ASC) AS position FROM scores)
        SELECT id,username,verified_count,position FROM ranked WHERE id=?
      `).bind(user.id).first();
    }
    return json({rankings:result.results||[],me});
  }

  if (path === "/api/reports" && method === "GET") {
    const result = await env.DB.prepare(`
      SELECT
        r.id,
        r.stop_id,
        r.description,
        r.location_name,
        r.latitude,
        r.longitude,
        r.observed_at,
        strftime('%Y-%m-%dT%H:%M:%SZ',COALESCE(r.created_at,r.observed_at)) AS created_at,
        EXISTS(SELECT 1 FROM report_photos p WHERE p.report_id=r.id) AS has_photo,
        r.meegestapt,
        r.gps_confirmed,
        r.status,
        (SELECT COUNT(*) FROM community_votes v WHERE v.report_id=r.id AND v.vote='still') AS still_count,
        (SELECT COUNT(*) FROM community_votes v WHERE v.report_id=r.id AND v.vote='gone') AS gone_count,
        (SELECT MAX(v.created_at) FROM community_votes v WHERE v.report_id=r.id AND v.vote='still') AS last_still_at,
        CASE WHEN r.route_id='all' THEN '—' ELSE tr.route_short_name END AS route_short_name,
        r.route_id,
        ts.stop_name,
        ts.stop_lat,
        ts.stop_lon
      FROM reports r
      LEFT JOIN transit_routes tr ON tr.route_id=r.route_id
      LEFT JOIN transit_stops ts ON ts.stop_id=r.stop_id
      WHERE r.status IN ('pending','approved')
        AND r.expires_at > ?
      ORDER BY r.observed_at DESC
      LIMIT 100
    `).bind(new Date().toISOString()).all();

    return json({reports:result.results||[]});
  }

  if (path === "/api/reports" && method === "POST") {
    const user = await currentUser(request,env);
    const ip=request.headers.get("CF-Connecting-IP")||"unknown";
    // Testfase: ruime limiet per internetverbinding. Verlaag MELDLIMIET_PER_UUR (bv. naar 3) bij de lancering.
    if(user?.role!=="admin" && !await rateLimitCommunity(env,"report:"+await hashText(ip),MELDLIMIET_PER_UUR,3600000))
      return json({error:"Maximum van "+MELDLIMIET_PER_UUR+" meldingen per uur bereikt. Probeer later opnieuw."},429);
    const b = await request.json().catch(()=>null);

    if (!b ||
        typeof b.route_id !== "string" ||
        !b.route_id ||
        typeof b.stop_id !== "string" ||
        !b.observed_at ||
        !Number.isFinite(Date.parse(b.observed_at))) {
      return json({
        error:"Kies een lijn, halte en geldig waarnemingstijdstip."
      },400);
    }

    const stop = b.route_id === "all"
      ? await env.DB.prepare(`
          SELECT stop_id,stop_name,stop_lat,stop_lon
          FROM transit_stops WHERE stop_id=?
        `).bind(b.stop_id).first()
      : await env.DB.prepare(`
          SELECT s.stop_id,s.stop_name,s.stop_lat,s.stop_lon
          FROM route_stops rs
          JOIN transit_stops s ON s.stop_id=rs.stop_id
          WHERE rs.route_id=? AND rs.stop_id=?
        `).bind(b.route_id,b.stop_id).first();

    if (!stop) {
      return json({
        error:"Deze halte hoort niet bij de gekozen lijn."
      },400);
    }

    const observed = new Date(b.observed_at);
    // Optionele foto: verkleinde JPEG/WebP als data-URL (de app verkleint en verwijdert EXIF/GPS).
    let foto=null;
    if(b.foto!=null&&b.foto!==""){
      const m=typeof b.foto==="string"&&b.foto.match(/^data:(image\/(?:jpeg|webp));base64,([A-Za-z0-9+/=]+)$/);
      if(!m||m[2].length>1400000) return json({error:"De foto is ongeldig of te groot."},400);
      const bin=atob(m[2]),bytes=new Uint8Array(bin.length);for(let i=0;i<bin.length;i++)bytes[i]=bin.charCodeAt(i);
      const jpeg=bytes[0]===0xFF&&bytes[1]===0xD8&&bytes[2]===0xFF,webp=bin.slice(0,4)==="RIFF"&&bin.slice(8,12)==="WEBP";
      if(!(m[1]==="image/jpeg"?jpeg:webp)) return json({error:"De foto is geen geldige afbeelding."},400);
      foto={mime:m[1],bytes};
    }

    if (observed.getTime() > Date.now()+5*60000 ||
        observed.getTime() < Date.now()-24*3600000) {
      return json({
        error:"Het waarnemingstijdstip moet binnen de afgelopen 24 uur liggen."
      },400);
    }

    let gpsConfirmed = 0;

    if (Number.isFinite(b.gps_latitude) &&
