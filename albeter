  for(const st of lijnTegels.get(k)||[]){
   const rids=st.r.map(ri=>idx.routes[ri]).filter(rid=>rid&&bekend.has(rid)&&idx.lijnen[rid]);
   if(!rids.length)continue;
   if(inBeeld.has(k))net.push({type:'Feature',properties:{ids:'|'+rids.join('|')+'|'},geometry:{type:'LineString',coordinates:st.c}});
   const strips=new Map();
   for(const rid of rids){
