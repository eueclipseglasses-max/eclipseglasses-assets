const $=id=>document.getElementById(id);const fmt=n=>Number(n||0).toLocaleString('nl-BE');function rows(id,data){const el=$(id);if(!data?.length){el.innerHTML='<div class="empty">Nog geen gegevens.</div>';return;}const max=Math.max(1,...data.map(x=>Number(x.count)));el.innerHTML=data.map(x=>'<div><div class="item"><span>'+esc(x.name||'Onbekend')+'</span><strong>'+fmt(x.count)+'</strong></div><div class="track"><i style="width:'+Math.max(1,Number(x.count)/max*100)+'%"></i></div></div>').join('');}function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function render(d){const k=d.summary||{};$('kpis').innerHTML=[['Paginaweergaven',k.pageviews],['Unieke bezoekers',k.visitors],['Bezoeken / sessies',k.sessions],['Terugkerende bezoekers',k.returning],['Actief (laatste 5 min.)',k.active],['Paginaweergaven vandaag',k.today]].map(x=>'<div class="card"><span>'+x[0]+'</span><strong>'+fmt(x[1])+'</strong></div>').join('');const daily=d.daily||[];const max=Math.max(1,...daily.map(x=>x.count));$('daily').innerHTML=daily.length?daily.map(x=>'<div class="barwrap" title="'+esc(x.day)+': '+fmt(x.count)+'"><div class="bar" style="height:'+Math.max(2,x.count/max*100)+'%"></div><small>'+esc(x.day.slice(5))+'</small></div>').join(''):'<div class="empty">Nog geen gegevens.</div>';rows('countries',d.countries);rows('cities',d.cities);rows('sources',d.sources);rows('pages',d.pages);rows('devices',d.devices);rows('browsers',d.browsers);$('status').textContent='Laatst bijgewerkt: '+new Date().toLocaleString('nl-BE')+' · '+fmt(k.pageviews)+' paginaweergaven in deze periode.';}
async function load(){ $('status').textContent='Statistieken laden…';try{const r=await fetch('/api/admin/analytics?range='+encodeURIComponent($('range').value),{credentials:'same-origin',cache:'no-store'});const d=await r.json();if(!r.ok)throw Error(d.error||'Geen toegang');render(d);}catch(e){$('status').innerHTML='<span class="error">'+esc(e.message)+'</span> · <a href="/">Log in op De Golem</a>';}}$('refresh').onclick=load;$('range').onchange=load;load();
</script></body></html>`;
