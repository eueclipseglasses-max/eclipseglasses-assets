        async function submitBulk(
      event
    ) {

      event.preventDefault();


      const form =
        event.target;


      const button =
        document.getElementById(
          "quoteSubmitButton"
        );


      const status =
        document.getElementById(
          "quoteStatus"
        );


      const name =
        document
          .getElementById(
            "bulkName"
          )
          .value
          .trim();


      const email =
        document
          .getElementById(
            "bulkEmail"
          )
          .value
          .trim();


      const quantity =
        document
          .getElementById(
            "bulkQuantity"
          )
          .value
          .trim();


      const message =
        document
          .getElementById(
            "bulkMessage"
          )
          .value
          .trim();


      const website =
        document
          .getElementById(
            "bulkWebsite"
          )
          .value
          .trim();


      status.classList.remove(
        "show"
      );


      status.classList.remove(
        "error"
      );


      if (
        !name ||
        !email ||
        !quantity
      ) {

        return;

      }


      button.disabled =
        true;


      button.style.opacity =
        "0.65";


      const originalButtonText =
        button.innerHTML;


      button.innerHTML =
        "<span>" + (extraTranslations[document.documentElement.lang] || extraTranslations.en).sending + "</span>";


      try {


        const response =
          await fetch(
            "/api/quote",
            {

              method:
                "POST",

              headers: {

                "Content-Type":
                  "application/json"

              },

              body:
                JSON.stringify({

                  name:
                    name,

                  email:
                    email,

                  quantity:
                    quantity,

                  message:
                    message,

                  website:
                    website

                })

            }
          );


        const result =
          await response.json();


        if (
          !response.ok ||
          !result.success
        ) {

          throw new Error(
            result.error ||
            "Something went wrong."
          );

        }


        status.innerHTML =

          "<strong>" + (extraTranslations[document.documentElement.lang] || extraTranslations.en).quoteReceived + "</strong><br>" +

          (extraTranslations[document.documentElement.lang] || extraTranslations.en).quoteReference + " <strong>" +

          escapeHTML(
            result.quoteNumber
          ) +

          "</strong>. " +

          (extraTranslations[document.documentElement.lang] || extraTranslations.en).quoteFollowup;


        status.classList.add(
          "show"
        );


        form.reset();


        document
          .getElementById(
            "bulkQuantity"
          )
          .value =
          "";


      } catch (error) {


        console.error(
          "Quote submission error:",
          error
        );


        status.textContent =
          error.message ||
          (extraTranslations[document.documentElement.lang] || extraTranslations.en).quoteError;


        status.classList.add(
          "show"
        );


        status.classList.add(
          "error"
        );


      } finally {


        button.disabled =
          false;


        button.style.opacity =
          "";


        button.innerHTML =
          originalButtonText;

      }

    }

