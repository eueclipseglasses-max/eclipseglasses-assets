// Stuk lijn tussen twee afstanden (meter) langs de lijn.
function lijnDeel(c,cum,d0,d1){
 const pt=d=>{let i=1;while(i<cum.length-1&&cum[i]<d)i++;const t=cum[i]>cum[i-1]?(d-cum[i-1])/(cum[i]-cum[i-1]):0;return [c[i-1][0]+(c[i][0]-c[i-1][0])*t,c[i-1][1]+(c[i][1]-c[i-1][1])*t];};
 const uit=[pt(d0)];for(let i=0;i<c.length;i++)if(cum[i]>d0&&cum[i]<d1)uit.push(c[i]);uit.push(pt(d1));return uit;
}
// Waar een strook van positie verandert (lijn voegt in of buigt af), schuift ze geleidelijk op
// over ~60 m in plaats van met een sprong.
function bouwStroken(stukken){
 const sleutel=p=>p[0].toFixed(5)+','+p[1].toFixed(5),knopen=new Map();
 for(const s of stukken){for(const eind of [false,true]){const k=sleutel(eind?s.c[s.c.length-1]:s.c[0]);if(!knopen.has(k))knopen.set(k,[]);knopen.get(k).push({s,eind});}}
 const buur=(s,x,aanEind)=>{
  let best=null,score=-1;
  for(const b of knopen.get(sleutel(aanEind?s.c[s.c.length-1]:s.c[0]))||[]){
   if(b.s===s)continue;const y=b.s.strips.find(y=>y.kleur===x.kleur&&y.ctrl===x.ctrl);if(!y)continue;
   const gedeeld=y.ids.filter(id=>x.ids.includes(id)).length;
   if(gedeeld>score){score=gedeeld;best={c:aanEind!==b.eind?y.c:-y.c,n:y.n};}
  }
  if(!best)return null;
  const m={c:(x.c+best.c)/2,n:(x.n+best.n)/2};
  return Math.abs(m.c-x.c)<0.01&&Math.abs(m.n-x.n)<0.01?null:m;
 };
 const features=[],STAPPEN=5;
 for(const s of stukken){
  const kx=111320*Math.cos(s.c[0][1]*Math.PI/180),cum=[0];
  for(let i=1;i<s.c.length;i++)cum.push(cum[i-1]+Math.hypot((s.c[i][0]-s.c[i-1][0])*kx,(s.c[i][1]-s.c[i-1][1])*110574));
  const lengte=cum[cum.length-1];
  for(const x of s.strips){
   const props=(c,n)=>({ids:'|'+x.ids.join('|')+'|',kleur:x.kleur,ctrl:x.ctrl,sk:x.sk,c,n});
   const voeg=(co,c,n)=>{if(co.length>1)features.push({type:'Feature',properties:props(c,n),geometry:{type:'LineString',coordinates:co}});};
   const b=buur(s,x,false),e=buur(s,x,true),Lb=b?Math.min(60,lengte*0.45):0,Le=e?Math.min(60,lengte*0.45):0;
   if(!Lb&&!Le){voeg(s.c,x.c,x.n);continue;}
   for(let i=0;i<STAPPEN&&Lb;i++){const t=(i+0.5)/STAPPEN;voeg(lijnDeel(s.c,cum,Lb*i/STAPPEN,Lb*(i+1)/STAPPEN),b.c+(x.c-b.c)*t,b.n+(x.n-b.n)*t);}
   voeg(lijnDeel(s.c,cum,Lb,lengte-Le),x.c,x.n);
   for(let i=0;i<STAPPEN&&Le;i++){const t=(i+0.5)/STAPPEN,d=lengte-Le;voeg(lijnDeel(s.c,cum,d+Le*i/STAPPEN,d+Le*(i+1)/STAPPEN),x.c+(e.c-x.c)*t,x.n+(e.n-x.n)*t);}
  }
 }
