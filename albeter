const PAGE_SCRIPT = String.raw`const PRICE_TIERS = [

      {
        min: 50,
        price: 99.95 / 50
      },

      {
        min: 25,
        price: 59.95 / 25
      },

      {
        min: 10,
        price: 29.95 / 10
      },

      {
        min: 5,
        price: 17.95 / 5
      },

      {
        min: 1,
        price: 4.95
      }

    ];


    let cart =
      JSON.parse(
        localStorage.getItem(
          "eclipse_cart"
        ) || "[]"
      );


    function getUnitPrice(quantity) {

      for (
        const tier of PRICE_TIERS
      ) {

        if (
          quantity >= tier.min
        ) {

          return tier.price;

        }

      }

      return 4.95;

    }


    function getCartCount() {

      return cart.reduce(
        (
          sum,
          item
        ) =>
          sum +
          item.quantity,
        0
      );

    }


    function saveCart() {

      localStorage.setItem(
        "eclipse_cart",
        JSON.stringify(cart)
      );

      renderCart();

    }


    function addToCart() {

      const quantityInput =
        document.getElementById(
          "quantity"
        );


      let quantity =
        parseInt(
          quantityInput.value,
          10
        );


      if (
        !Number.isInteger(quantity) ||
        quantity < 1
      ) {
        quantity = 1;
      }

      const existing =
        cart.find(
          item =>
            item.id ===
            "solar-glasses"
        );

      const currentQuantity = existing ? existing.quantity : 0;
      const retailLimit = 50;

      if (quantity > retailLimit || currentQuantity + quantity > retailLimit) {
        showRetailLimitNotice();
        quantityInput.value = Math.max(1, Math.min(retailLimit - currentQuantity, retailLimit));
        return;
      }

      hideRetailLimitNotice();

      if (existing) {

        existing.quantity +=
          quantity;

      } else {

        cart.push({

          id:
            "solar-glasses",

          name:
            "Solar Eclipse Glasses",

          quantity:
            quantity

        });

      }


      saveCart();
      openCart();

    }


    let retailLimitNoticeTimer;
    let retailLimitFadeTimer;

    function showRetailLimitNotice() {
      clearTimeout(retailLimitNoticeTimer);
      clearTimeout(retailLimitFadeTimer);
      const language = document.documentElement.lang || "en";
      const messages = {
        en: { title: "Planning a larger order?", body: "Retail orders are limited to 50 pairs. For larger quantities, please ", link: "request a B2B quote", end: "." },
        nl: { title: "Een grotere bestelling gepland?", body: "Gewone bestellingen zijn beperkt tot 50 brillen. Vraag voor grotere aantallen een ", link: "B2B-offerte aan", end: "." },
        fr: { title: "Vous prévoyez une commande plus importante ?", body: "Les commandes classiques sont limitées à 50 paires. Pour une plus grande quantité, ", link: "demandez un devis B2B", end: "." },
        es: { title: "¿Necesitas un pedido más grande?", body: "Los pedidos minoristas están limitados a 50 gafas. Para cantidades mayores, ", link: "solicita un presupuesto B2B", end: "." }
      };
      const message = messages[language] || messages.en;
      ["retailLimitNotice", "cartRetailLimitNotice"].forEach(id => {
        const notice = document.getElementById(id);
        if (!notice) return;
        notice.innerHTML = '<span class="notice-title">' + message.title + '</span>' +
          message.body + '<a href="#bulk" onclick="hideRetailLimitNotice()">' +
          message.link + '</a>' + message.end;
        notice.classList.remove("fade-out");
        notice.classList.add("show");
      });

      // Keep the warning temporary, then fade it out smoothly.
      retailLimitNoticeTimer = setTimeout(hideRetailLimitNotice, 6000);
    }

    function hideRetailLimitNotice() {
      clearTimeout(retailLimitNoticeTimer);
      clearTimeout(retailLimitFadeTimer);
      ["retailLimitNotice", "cartRetailLimitNotice"].forEach(id => {
        const notice = document.getElementById(id);
        if (notice && notice.classList.contains("show")) {
          notice.classList.add("fade-out");
        }
      });
      retailLimitFadeTimer = setTimeout(() => {
        ["retailLimitNotice", "cartRetailLimitNotice"].forEach(id => {
          const notice = document.getElementById(id);
          if (notice) {
            notice.classList.remove("show", "fade-out");
            notice.textContent = "";
          }
        });
      }, 850);
    }


    function changeQuantity(
      index,
      amount
    ) {

      if (!cart[index]) {
        return;
      }


      cart[index].quantity +=
        amount;

      if (cart[index].quantity > 50) {
        cart[index].quantity = 50;
        showRetailLimitNotice();
      }

      if (
        cart[index].quantity <= 0
      ) {

        cart.splice(
          index,
          1
        );

      }


      saveCart();

    }


    function removeItem(index) {

      cart.splice(
        index,
        1
      );

      saveCart();

    }


    function renderCart() {

      const currentLanguage = document.documentElement.lang || "en";
      const cartDictionary = {
        ...(translations[currentLanguage] || translations.en),
        ...(extraTranslations[currentLanguage] || extraTranslations.en)
      };
      const numberLocale = ({ en: "en-IE", nl: "nl-BE", fr: "fr-BE", es: "es-ES" })[currentLanguage] || "en-IE";
      const formatMoney = value => new Intl.NumberFormat(numberLocale, { style: "currency", currency: "EUR" }).format(value);

      const container =
        document.getElementById(
          "cartItems"
        );


      const count =
        document.getElementById(
          "cartCount"
        );


      const totalElement =
        document.getElementById(
          "cartTotal"
        );


      count.textContent =
        getCartCount();


      if (!cart.length) {

        container.innerHTML =
          '<div class="cart-empty">' +
            cartDictionary.cartEmpty +
          '</div>';


        totalElement.textContent =
          formatMoney(0);


        return;

      }


      let total = 0;
      let cartHTML = "";


      cart.forEach(
        (
          item,
          index
        ) => {


          const unitPrice =
            getUnitPrice(
              item.quantity
            );


          const itemTotal =
            unitPrice *
            item.quantity;


          total +=
            itemTotal;


          cartHTML +=

            '<div class="cart-item">' +

              '<div>' +

                '<div class="cart-item-name">' +
                  escapeHTML(
                    item.name
                  ) +
                '</div>' +

                '<div class="cart-item-detail">' +
                  formatMoney(unitPrice) +
                  ' ' + cartDictionary.pricePerPair +
                '</div>' +

                '<div class="cart-controls">' +

                  '<button ' +
                    'class="cart-control" ' +
                    'onclick="changeQuantity(' +
                      index +
                      ', -1)"' +
                  '>−</button>' +

                  '<span>' +
                    item.quantity +
                  '</span>' +

                  '<button ' +
                    'class="cart-control" ' +
                    'onclick="changeQuantity(' +
                      index +
                      ', 1)"' +
                  '>+</button>' +

                  '<button ' +
                    'class="remove-item" ' +
                    'onclick="removeItem(' +
                      index +
                    ')"' +
                  '>' +
                    cartDictionary.cartRemove +
                  '</button>' +

                '</div>' +

              '</div>' +

              '<div class="cart-item-price">' +
                formatMoney(itemTotal) +
              '</div>' +

            '</div>';

        }
      );


      container.innerHTML =
        cartHTML;


      totalElement.textContent =
        formatMoney(total);

    }


    function escapeHTML(value) {

      return String(value)

        .replace(
          /&/g,          "&amp;"
        )

        .replace(
          /</g,
