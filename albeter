      const dLat = rad(b.gps_latitude - stop.stop_lat);
      const dLon = rad(b.gps_longitude - stop.stop_lon);

      const a =
        Math.sin(dLat/2)**2 +
        Math.cos(rad(stop.stop_lat)) *
        Math.cos(rad(b.gps_latitude)) *
        Math.sin(dLon/2)**2;

      const distance =
        6371000 * 2 *
        Math.atan2(Math.sqrt(a),Math.sqrt(1-a));

      gpsConfirmed = distance <= 150 ? 1 : 0;
    }

    let reportUserId=user?.id??null;
    if(!reportUserId){
