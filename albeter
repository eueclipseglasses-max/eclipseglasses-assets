          border-color .24s ease,
          box-shadow .24s ease,
          opacity .18s ease;
        will-change: left, top, width, height;
      }

      .eg-cursor::before {
        content: "";
        position: absolute;
        inset: -13px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(var(--eg-cursor-rgb), .22) 0%, rgba(var(--eg-cursor-rgb), .10) 34%, rgba(var(--eg-cursor-rgb), 0) 72%);
