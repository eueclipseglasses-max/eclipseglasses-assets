<script>
let mode='login', map;
const reportMarkers=[];
const $=id=>document.getElementById(id);
function applyMapTone(){
 if(!map)return;
 map.getCanvas().style.filter=document.documentElement.dataset.theme==='dark'
  ?'grayscale(1) brightness(.78) contrast(1.12)'
  :'none';
}
function applyTheme(theme){
 document.documentElement.dataset.theme=theme;
 const themeColor=document.querySelector('meta[name="theme-color"]');
 if(themeColor)themeColor.content=theme==='light'?'#f3f5f8':'#0b0d11';
 $('themeButton').textContent=theme==='light'?'☾ Donkere modus':'☼ Lichte modus';
 if(map){
  map.setStyle(theme==='light'?'https://tiles.openfreemap.org/styles/positron':'https://tiles.openfreemap.org/styles/dark');
  map.once('style.load',applyMapTone);
 }
 try{localStorage.setItem('radar-theme',theme);}catch(e){}
}
function toggleTheme(){
 applyTheme(document.documentElement.dataset.theme==='light'?'dark':'light');
}
try{applyTheme(localStorage.getItem('radar-theme')||'dark');}catch(e){document.documentElement.dataset.theme='dark';}
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
async function api(path,options={}) {
 const r=await fetch(path,{...options,headers:{'Content-Type':'application/json',...(options.headers||{})}});
 const data=await r.json().catch(()=>({error:'Ongeldig serverantwoord'}));
 if(!r.ok) throw new Error(data.error||'Er ging iets mis');
 return data;
}
function setMode(next){
 mode=next;
 $('authTitle').textContent=next==='login'?'Welkom terug':'Account aanmaken';
 $('authSubmit').textContent=next==='login'?'Inloggen':'Registreren';
 $('loginTab').className=next==='login'?'':'secondary';
 $('registerTab').className=next==='register'?'':'secondary';
 $('password').autocomplete=next==='login'?'current-password':'new-password';
 $('authMessage').textContent='';
}
$('authForm').addEventListener('submit',async e=>{
 e.preventDefault();$('authMessage').textContent='Even geduld...';
 try{
  await api('/api/auth/'+mode,{method:'POST',body:JSON.stringify({email:$('email').value,password:$('password').value})});
  await startApp();
 }catch(err){$('authMessage').textContent=err.message;}
});
async function logout(){try{await api('/api/auth/logout',{method:'POST',body:'{}'});}catch{} await startPublicApp();}
function authAction(){if($('reportForm').classList.contains('hidden'))openAuth();else logout();}
function openAuth(){$('appScreen').classList.add('hidden');$('authScreen').classList.remove('hidden');$('authButton').classList.add('hidden');setMode('login');}
function showPublicDashboard(){startPublicApp();}
function initMap(){
 if(map)return;
 map=new maplibregl.Map({container:'map',style:document.documentElement.dataset.theme==='light'?'https://tiles.openfreemap.org/styles/positron':'https://tiles.openfreemap.org/styles/dark',center:[4.45,51.05],zoom:8,attributionControl:true});
 map.addControl(new maplibregl.NavigationControl({showCompass:false}),'top-right');
 map.on('error',e=>console.error('Kaartfout:',e.error||e));
 if(navigator.geolocation){
  navigator.geolocation.getCurrentPosition(pos=>{
   map.flyTo({center:[pos.coords.longitude,pos.coords.latitude],zoom:15});
  },()=>{}, {enableHighAccuracy:true,timeout:10000,maximumAge:60000});
 }
}
function formatDate(s){return new Date(s).toLocaleString('nl-BE',{dateStyle:'medium',timeStyle:'short'});}
function reportCard(r,admin=false){
 const route='Lijn '+(r.route_short_name||'—');
 const stop=r.stop_name||r.location_name||'Halte onbekend';
 const gps=r.gps_confirmed
  ?'<span class="tag">✓ GPS bevestigd</span>'
  :'<span class="tag orange">GPS niet bevestigd</span>';
 const actions=admin
  ?'<div class="report-actions"><button data-id="'+esc(r.id)+'" data-status="approved">Goedkeuren</button><button class="danger" data-id="'+esc(r.id)+'" data-status="rejected">Afwijzen</button></div>'
  :'';
 return '<article class="report">'+
  '<div class="report-head"><span class="report-title">'+esc(stop)+'</span><time class="report-time">'+esc(formatDate(r.observed_at))+'</time></div>'+
  '<div class="report-meta"><span class="tag">'+esc(route)+'</span>'+gps+'</div>'+
  actions+'</article>';
}
let gpsCheck=null;
async function loadRoutes(){
 const data=await api('/api/routes');
 $('routeSelect').innerHTML='<option value="">Kies een lijn</option>'+data.routes.map(r=>'<option value="'+esc(r.route_id)+'">Lijn '+esc(r.route_short_name)+' · '+esc(r.route_long_name)+'</option>').join('');
}
async function loadStops(routeId){
 $('stopSelect').disabled=true;$('stopSelect').innerHTML='<option value="">Haltes laden...</option>';
 gpsCheck=null;$('gpsMessage').textContent='GPS-controle is optioneel. Je exacte GPS-coördinaten worden niet openbaar getoond of opgeslagen.';
 if(!routeId){$('stopSelect').innerHTML='<option value="">Kies eerst een lijn</option>';return;}
 const data=await api('/api/routes/'+encodeURIComponent(routeId)+'/stops');
 $('stopSelect').innerHTML='<option value="">Kies een halte</option>'+data.stops.map(s=>'<option value="'+esc(s.stop_id)+'">'+esc(s.stop_name)+'</option>').join('');
