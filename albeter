    // Let desktop users drag the product image itself to explore it.
    const productScroller = document.querySelector(".product-image-scroll");
    if (productScroller) {
      let isDragging = false;
      let startX = 0;
      let startScrollLeft = 0;
      let dragged = false;

      productScroller.addEventListener("pointerdown", event => {
        if (event.pointerType === "touch") return; // Keep native swipe scrolling on touchscreens.
        if (event.target.closest(".product-image-hint")) return;
        isDragging = true;
        dragged = false;
        startX = event.clientX;
        startScrollLeft = productScroller.scrollLeft;
        productScroller.classList.add("is-dragging");
      });

      window.addEventListener("pointermove", event => {
        if (!isDragging) return;
        const distance = event.clientX - startX;
        if (Math.abs(distance) > 3) dragged = true;
        if (dragged) {
          productScroller.scrollLeft = startScrollLeft - distance;
          event.preventDefault();
        }
      }, { passive: false });

      const stopProductDrag = () => {
        isDragging = false;
        productScroller.classList.remove("is-dragging");
      };
      window.addEventListener("pointerup", stopProductDrag);
      window.addEventListener("pointercancel", stopProductDrag);

      productScroller.addEventListener("dragstart", event => event.preventDefault());
    }

