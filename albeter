 map.setPaintProperty('golem-lijnen-rand','line-opacity',0.9);
 map.setPaintProperty('golem-lijnen-rand','line-color',donker?'#0b0d10':'#ffffff');
 for(const id of ['golem-lijnen','golem-lijnen-rand'])map.setLayoutProperty(id,'line-sort-key',['get','sk']);
}
// Rode gloed rond lijnen met een recente controle laten pulseren.
function zetPuls(aan){
 if(!aan){if(pulsTimer){clearInterval(pulsTimer);pulsTimer=0;}return;}
 if(pulsTimer)return;
 pulsTimer=setInterval(()=>{
  if(document.hidden||!map||!map.getLayer('golem-controle-gloed'))return;
  const f=(performance.now()%1800)/1800;
  map.setPaintProperty('golem-controle-gloed','line-opacity',0.12+0.5*(0.5-0.5*Math.cos(f*2*Math.PI)));
 },70);
