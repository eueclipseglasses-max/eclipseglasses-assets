const json = (data, status = 200, extra = {}) =>
  new Response(JSON.stringify(data), {
    status,
    headers: {
      "Content-Type": "application/json; charset=utf-8",
      "Cache-Control": "no-store",
      ...extra
    }
  });

const randomId = () => crypto.randomUUID();

async function hashText(value) {
  const bytes = new TextEncoder().encode(value);
  const digest = await crypto.subtle.digest("SHA-256", bytes);
  return [...new Uint8Array(digest)]
    .map(b => b.toString(16).padStart(2, "0")).join("");
}

async function passwordHash(password, salt) {
  const key = await crypto.subtle.importKey(
    "raw", new TextEncoder().encode(password), "PBKDF2", false, ["deriveBits"]
  );
  const bits = await crypto.subtle.deriveBits({
    name: "PBKDF2",
    salt: new TextEncoder().encode(salt),
    iterations: 100000,
    hash: "SHA-256"
  }, key, 256);
  return [...new Uint8Array(bits)].map(b => b.toString(16).padStart(2, "0")).join("");
}

function cookie(name, value, maxAge) {
  return `${name}=${value}; HttpOnly; Secure; SameSite=Strict; Path=/; Max-Age=${maxAge}`;
}

async function currentUser(request, env) {
  const raw = request.headers.get("Cookie") || "";
  const token = raw.split(";").map(x => x.trim())
    .find(x => x.startsWith("radar_session="))?.split("=")[1];
  if (!token) return null;
  const tokenHash = await hashText(token);
  const row = await env.DB.prepare(`
    SELECT users.id, users.email, users.role
    FROM sessions JOIN users ON users.id=sessions.user_id
    WHERE sessions.token_hash=? AND sessions.expires_at > ?
  `).bind(tokenHash, new Date().toISOString()).first();
  return row || null;
}

async function createSession(userId, env) {
  const bytes = crypto.getRandomValues(new Uint8Array(32));
  const token = [...bytes].map(b => b.toString(16).padStart(2, "0")).join("");
  const tokenHash = await hashText(token);
  const expires = new Date(Date.now() + 7 * 86400000).toISOString();
  await env.DB.prepare(
    "INSERT INTO sessions(id,user_id,token_hash,expires_at) VALUES(?,?,?,?)"
  ).bind(randomId(), userId, tokenHash, expires).run();
  return cookie("radar_session", token, 7 * 86400);
}

function validEmail(email) {
  return typeof email === "string" && email.length <= 254 &&
    /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
}

async function handleApi(request, env) {
  const url = new URL(request.url);
  const path = url.pathname;
  const method = request.method;

  if (method !== "GET") {
    const origin = request.headers.get("Origin");
    if (origin && origin !== url.origin) {
      return json({error:"Ongeldige oorsprong"},403);
    }
  }

  if (path === "/manifest.webmanifest" && method === "GET") {
    return new Response(JSON.stringify({
      name: "De Lijn Radar",
      short_name: "Radar",
      start_url: "/",
      display: "standalone",
      background_color: "#0b0d11",
      theme_color: "#0b0d11",
      icons: [{
        src: "/icon.svg",
        sizes: "any",
        type: "image/svg+xml"
      }]
    }), {
      headers: {"Content-Type":"application/manifest+json"}
    });
  }

  if (path === "/icon.svg" && method === "GET") {
    return new Response(
      '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><rect width="512" height="512" rx="100" fill="#0b0d11"/><text x="256" y="350" font-size="300" text-anchor="middle" font-weight="bold" fill="#ef4444">R</text></svg>',
      {headers:{"Content-Type":"image/svg+xml"}}
    );
  }

  if (path === "/sw.js" && method === "GET") {
    return new Response(`
      const CACHE = "radar-shell-v8";

      self.addEventListener("install", event => {
        event.waitUntil(caches.open(CACHE).then(cache => cache.add("/")));
        self.skipWaiting();
      });

      self.addEventListener("activate", event => {
        event.waitUntil(
          caches.keys().then(keys =>
            Promise.all(keys.filter(k => k !== CACHE).map(k => caches.delete(k)))
          )
        );
        self.clients.claim();
      });

      self.addEventListener("fetch", event => {
        const url = new URL(event.request.url);
        if (url.origin !== self.location.origin) return;
        if (url.pathname.startsWith("/api/")) return;
        if (event.request.mode === "navigate") {
          event.respondWith(fetch(event.request).catch(() => caches.match("/")));
        }
      });
    `, {
      headers:{
        "Content-Type":"application/javascript",
        "Cache-Control":"no-cache"
      }
    });
  }

  if (path === "/api/auth/register" && method === "POST") {
    const body = await request.json().catch(() => null);

    if (!body || !validEmail(body.email) ||
        typeof body.password !== "string" ||
        body.password.length < 10 ||
        body.password.length > 128) {
      return json({error:"Gebruik een geldig e-mailadres en een wachtwoord van minstens 10 tekens."},400);
    }

    const email = body.email.trim().toLowerCase();

    const exists = await env.DB.prepare(
      "SELECT id FROM users WHERE email=?"
    ).bind(email).first();

    if (exists) {
      return json({error:"Dit e-mailadres is al geregistreerd."},409);
    }

    const id = randomId();
    const salt = randomId();
    const hash = salt + ":" + await passwordHash(body.password,salt);

    await env.DB.prepare(
      "INSERT INTO users(id,email,password_hash,role) VALUES(?,?,?,'user')"
    ).bind(id,email,hash).run();

    const sessionCookie = await createSession(id,env);
    return json({success:true},201,{"Set-Cookie":sessionCookie});
  }

  if (path === "/api/auth/login" && method === "POST") {
    const body = await request.json().catch(() => null);

    if (!body || !validEmail(body.email) ||
        typeof body.password !== "string") {
      return json({error:"Controleer je inloggegevens."},400);
    }

    const user = await env.DB.prepare(
      "SELECT id,password_hash FROM users WHERE email=?"
    ).bind(body.email.trim().toLowerCase()).first();

    if (!user) {
      return json({error:"E-mailadres of wachtwoord is onjuist."},401);
    }

    const [salt,stored] = user.password_hash.split(":");
    const calculated = await passwordHash(body.password,salt);

    if (calculated !== stored) {
      return json({error:"E-mailadres of wachtwoord is onjuist."},401);
    }

    const sessionCookie = await createSession(user.id,env);
    return json({success:true},200,{"Set-Cookie":sessionCookie});
  }

  if (path === "/api/auth/logout" && method === "POST") {
    const user = await currentUser(request,env);

    if (user) {
      const token = (request.headers.get("Cookie")||"")
        .split(";")
        .map(x=>x.trim())
        .find(x=>x.startsWith("radar_session="))
        ?.split("=")[1];

      if (token) {
        await env.DB.prepare(
          "DELETE FROM sessions WHERE token_hash=?"
        ).bind(await hashText(token)).run();
      }
    }

    return json({success:true},200,{
      "Set-Cookie":cookie("radar_session","",0)
    });
  }

  if (path === "/api/me" && method === "GET") {
    const user = await currentUser(request,env);
    if (!user) return json({error:"Niet ingelogd"},401);
    return json({user});
  }

  if (path === "/api/routes" && method === "GET") {
    const result = await env.DB.prepare(`
      SELECT route_id, route_short_name, route_long_name
      FROM transit_routes
      ORDER BY route_short_name, route_long_name
    `).all();

    return json({routes:result.results||[]});
  }

  if (path.startsWith("/api/routes/") &&
      path.endsWith("/stops") &&
      method === "GET") {

    const routeId = decodeURIComponent(
      path.slice("/api/routes/".length, -"/stops".length)
    );

    const result = await env.DB.prepare(`
      SELECT s.stop_id, s.stop_name, s.stop_lat, s.stop_lon
      FROM route_stops rs
      JOIN transit_stops s ON s.stop_id=rs.stop_id
      WHERE rs.route_id=?
      ORDER BY s.stop_name
    `).bind(routeId).all();

    return json({stops:result.results||[]});
  }

  if (path === "/api/reports" && method === "GET") {
    const result = await env.DB.prepare(`
      SELECT
        r.id,
        r.description,
        r.location_name,
        r.latitude,
        r.longitude,
        r.observed_at,
        COALESCE(r.created_at,r.observed_at) AS created_at,
        r.gps_confirmed,
        tr.route_short_name,
        ts.stop_name
      FROM reports r
      LEFT JOIN transit_routes tr ON tr.route_id=r.route_id
      LEFT JOIN transit_stops ts ON ts.stop_id=r.stop_id
      WHERE r.status='approved'
        AND r.expires_at > ?
      ORDER BY r.observed_at DESC
      LIMIT 100
    `).bind(new Date().toISOString()).all();

    return json({reports:result.results||[]});
  }

  if (path === "/api/reports" && method === "POST") {
    const user = await currentUser(request,env);
    if (!user) return json({error:"Log eerst in"},401);

    const b = await request.json().catch(()=>null);

    if (!b ||
        typeof b.route_id !== "string" ||
        typeof b.stop_id !== "string" ||
        !b.observed_at ||
        !Number.isFinite(Date.parse(b.observed_at))) {
      return json({
        error:"Kies een lijn, halte en geldig waarnemingstijdstip."
      },400);
    }

    const stop = await env.DB.prepare(`
      SELECT
        s.stop_id,
        s.stop_name,
        s.stop_lat,
        s.stop_lon
      FROM route_stops rs
      JOIN transit_stops s ON s.stop_id=rs.stop_id
      WHERE rs.route_id=? AND rs.stop_id=?
    `).bind(b.route_id,b.stop_id).first();

    if (!stop) {
      return json({
        error:"Deze halte hoort niet bij de gekozen lijn."
      },400);
    }

    const observed = new Date(b.observed_at);

    if (observed.getTime() > Date.now()+5*60000 ||
        observed.getTime() < Date.now()-24*3600000) {
      return json({
        error:"Het waarnemingstijdstip moet binnen de afgelopen 24 uur liggen."
      },400);
    }

    let gpsConfirmed = 0;

    if (Number.isFinite(b.gps_latitude) &&
        Number.isFinite(b.gps_longitude) &&
        b.gps_latitude >= -90 &&
        b.gps_latitude <= 90 &&
        b.gps_longitude >= -180 &&
        b.gps_longitude <= 180) {

      const rad = n => n * Math.PI / 180;
      const dLat = rad(b.gps_latitude - stop.stop_lat);
      const dLon = rad(b.gps_longitude - stop.stop_lon);

      const a =
        Math.sin(dLat/2)**2 +
        Math.cos(rad(stop.stop_lat)) *
        Math.cos(rad(b.gps_latitude)) *
        Math.sin(dLon/2)**2;

      const distance =
        6371000 * 2 *
        Math.atan2(Math.sqrt(a),Math.sqrt(1-a));

      gpsConfirmed = distance <= 150 ? 1 : 0;
    }

    await env.DB.prepare(`
      INSERT INTO reports(
        id,
        user_id,
        description,
        location_name,
        latitude,
        longitude,
        observed_at,
        status,
        expires_at,
        route_id,
        stop_id,
        gps_confirmed
      )
      VALUES(?,?,?,?,?,?,?,'pending',?,?,?,?)
    `).bind(
      randomId(),
      user.id,
      "",
      stop.stop_name,
      stop.stop_lat,
      stop.stop_lon,
      observed.toISOString(),
      new Date(Date.now()+3*3600000).toISOString(),
      b.route_id,
      b.stop_id,
      gpsConfirmed
    ).run();

    return json({
      success:true,
      message:"Melding wacht op moderatie.",
      gps_confirmed:!!gpsConfirmed
    },201);
  }

  if (path === "/api/admin/pending" && method === "GET") {
    const user = await currentUser(request,env);

    if (!user || user.role !== "admin") {
      return json({error:"Geen beheerdersrechten"},403);
    }

    const result = await env.DB.prepare(`
      SELECT
        r.id,
        r.description,
        r.location_name,
        r.latitude,
        r.longitude,
        r.observed_at,
        r.gps_confirmed,
        tr.route_short_name,
        ts.stop_name
      FROM reports r
      LEFT JOIN transit_routes tr ON tr.route_id=r.route_id
      LEFT JOIN transit_stops ts ON ts.stop_id=r.stop_id
      WHERE r.status='pending'
      ORDER BY r.created_at DESC
      LIMIT 100
    `).all();

    return json({reports:result.results||[]});
  }

  if (path === "/api/admin/moderate" && method === "POST") {
    const user = await currentUser(request,env);

    if (!user || user.role !== "admin") {
      return json({error:"Geen beheerdersrechten"},403);
    }

    const b = await request.json().catch(()=>null);

    if (!b ||
        typeof b.id !== "string" ||
        !["approved","rejected"].includes(b.status)) {
      return json({error:"Ongeldige aanvraag"},400);
    }

    await env.DB.prepare(
      "UPDATE reports SET status=? WHERE id=? AND status='pending'"
    ).bind(b.status,b.id).run();

    return json({success:true});
  }

  return json({error:"Endpoint niet gevonden"},404);
}

export default {
  async fetch(request,env) {
    try {
      const url = new URL(request.url);

      if (["/manifest.webmanifest","/icon.svg","/sw.js"].includes(url.pathname)) {
        return await handleApi(request,env);
      }

      if (url.pathname.startsWith("/api/")) {
        if (!env.DB) {
          return json({
            error:"D1 databasebinding ontbreekt. Voeg de binding DB toe."
          },500);
        }

        return await handleApi(request,env);
      }

      if (request.method !== "GET") {
        return new Response("Method not allowed",{status:405});
      }

      return new Response(HTML,{
        headers:{
          "Content-Type":"text/html; charset=utf-8",
          "Cache-Control":"no-store",
          "X-Content-Type-Options":"nosniff",
          "Referrer-Policy":"strict-origin-when-cross-origin",
          "Content-Security-Policy":"default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; connect-src 'self' https://tiles.openfreemap.org; font-src 'self' data: https://tiles.openfreemap.org; worker-src blob:;"
        }
      });

    } catch(error) {
      return json({
        error:String(error?.message || error)
      },500);
    }
  }
};
