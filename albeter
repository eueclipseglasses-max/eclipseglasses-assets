      const contact=CONTACT_EMAIL?'<a href="mailto:'+CONTACT_EMAIL+'">'+CONTACT_EMAIL+'</a>':'het contactadres dat hier binnenkort komt';
      const infoPages={
        "/over":["Over De Golem",
          '<p>De Golem is een onafhankelijk initiatief van reizigers. Op een kaart zie je meldingen van andere reizigers over controles ("controles") op het net van De Lijn, en je kunt er zelf een melden.</p>'+
