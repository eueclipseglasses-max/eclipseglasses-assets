      SELECT s.stop_id, s.stop_name, s.stop_lat, s.stop_lon
      FROM route_stops rs
      JOIN transit_stops s ON s.stop_id=rs.stop_id
      WHERE rs.route_id=?
      ORDER BY s.stop_name
    `).bind(routeId).all();

    return json({stops:result.results||[]});
  }

  if (path === "/api/stops" && method === "GET") {
    const result = await env.DB.prepare(`
      SELECT s.stop_id,s.stop_name,s.stop_lat,s.stop_lon,GROUP_CONCAT(DISTINCT rs.route_id) AS route_ids
      FROM transit_stops s JOIN route_stops rs ON rs.stop_id=s.stop_id
      WHERE s.stop_lat IS NOT NULL AND s.stop_lon IS NOT NULL
      GROUP BY s.stop_id,s.stop_name,s.stop_lat,s.stop_lon ORDER BY s.stop_name
    `).all();
    return json({stops:result.results||[]});
  }

  if (path === "/api/ranking" && method === "GET") {
    const user=await currentUser(request,env);
    const result=await env.DB.prepare(`
      SELECT u.id,substr(u.email,1,instr(u.email,'@')-1) AS username,COUNT(r.id) AS verified_count
      FROM users u JOIN reports r ON r.user_id=u.id
      WHERE r.status='approved' AND u.email NOT LIKE 'anonymous+%@degolem.invalid'
      GROUP BY u.id,u.email
      HAVING COUNT(r.id)>0
      ORDER BY verified_count DESC,username COLLATE NOCASE ASC
      LIMIT 100
    `).all();
    let me=null;
    if(user){
      me=await env.DB.prepare(`
        WITH scores AS (
          SELECT u.id,substr(u.email,1,instr(u.email,'@')-1) AS username,COUNT(r.id) AS verified_count
          FROM users u JOIN reports r ON r.user_id=u.id
          WHERE r.status='approved' AND u.email NOT LIKE 'anonymous+%@degolem.invalid'
          GROUP BY u.id,u.email HAVING COUNT(r.id)>0
        ), ranked AS (SELECT *,ROW_NUMBER() OVER(ORDER BY verified_count DESC,username COLLATE NOCASE ASC) AS position FROM scores)
        SELECT id,username,verified_count,position FROM ranked WHERE id=?
      `).bind(user.id).first();
    }
    return json({rankings:result.results||[],me});
  }

  if (path === "/api/reports" && method === "GET") {
    const result = await env.DB.prepare(`
      SELECT
        r.id,
        r.stop_id,
        r.description,
        r.location_name,
        r.latitude,
        r.longitude,
        r.observed_at,
        COALESCE(r.created_at,r.observed_at) AS created_at,
        r.gps_confirmed,
        r.status,
        (SELECT COUNT(*) FROM community_votes v WHERE v.report_id=r.id AND v.vote='still') AS still_count,
        (SELECT COUNT(*) FROM community_votes v WHERE v.report_id=r.id AND v.vote='gone') AS gone_count,
        CASE WHEN r.route_id='all' THEN '—' ELSE tr.route_short_name END AS route_short_name,
        r.route_id,
        ts.stop_name,
        ts.stop_lat,
        ts.stop_lon
      FROM reports r
      LEFT JOIN transit_routes tr ON tr.route_id=r.route_id
      LEFT JOIN transit_stops ts ON ts.stop_id=r.stop_id
      WHERE r.status IN ('pending','approved')
        AND r.expires_at > ?
      ORDER BY r.observed_at DESC
      LIMIT 100
    `).bind(new Date().toISOString()).all();

    return json({reports:result.results||[]});
  }

  if (path === "/api/reports" && method === "POST") {
    const user = await currentUser(request,env);
    const ip=request.headers.get("CF-Connecting-IP")||"unknown";
    if(!await rateLimitCommunity(env,"report:"+await hashText(ip),3,3600000))
      return json({error:"Maximum van 3 meldingen per uur bereikt. Probeer later opnieuw."},429);
    const b = await request.json().catch(()=>null);

    if (!b ||
        typeof b.route_id !== "string" ||
        !b.route_id ||
        typeof b.stop_id !== "string" ||
        !b.observed_at ||
        !Number.isFinite(Date.parse(b.observed_at))) {
      return json({
        error:"Kies een lijn, halte en geldig waarnemingstijdstip."
      },400);
    }

    const stop = b.route_id === "all"
      ? await env.DB.prepare(`
          SELECT stop_id,stop_name,stop_lat,stop_lon
          FROM transit_stops WHERE stop_id=?
        `).bind(b.stop_id).first()
      : await env.DB.prepare(`
          SELECT s.stop_id,s.stop_name,s.stop_lat,s.stop_lon
          FROM route_stops rs
          JOIN transit_stops s ON s.stop_id=rs.stop_id
          WHERE rs.route_id=? AND rs.stop_id=?
        `).bind(b.route_id,b.stop_id).first();

    if (!stop) {
      return json({
        error:"Deze halte hoort niet bij de gekozen lijn."
      },400);
    }

    const observed = new Date(b.observed_at);

    if (observed.getTime() > Date.now()+5*60000 ||
        observed.getTime() < Date.now()-24*3600000) {
      return json({
        error:"Het waarnemingstijdstip moet binnen de afgelopen 24 uur liggen."
      },400);
    }

    let gpsConfirmed = 0;

    if (Number.isFinite(b.gps_latitude) &&
        Number.isFinite(b.gps_longitude) &&
        b.gps_latitude >= -90 &&
        b.gps_latitude <= 90 &&
        b.gps_longitude >= -180 &&
        b.gps_longitude <= 180) {

      const rad = n => n * Math.PI / 180;
      const dLat = rad(b.gps_latitude - stop.stop_lat);
      const dLon = rad(b.gps_longitude - stop.stop_lon);

      const a =
        Math.sin(dLat/2)**2 +
        Math.cos(rad(stop.stop_lat)) *
        Math.cos(rad(b.gps_latitude)) *
        Math.sin(dLon/2)**2;

      const distance =
        6371000 * 2 *
        Math.atan2(Math.sqrt(a),Math.sqrt(1-a));

      gpsConfirmed = distance <= 150 ? 1 : 0;
    }

    let reportUserId=user?.id??null;
    if(!reportUserId){
      const anonHash=await hashText(ip);
      reportUserId='anon_'+anonHash.slice(0,32);
      await env.DB.prepare("INSERT OR IGNORE INTO users(id,email,password_hash,role) VALUES(?,?,?,'user')")
        .bind(reportUserId,'anonymous+'+anonHash+'@degolem.invalid','anonymous-account').run();
    }

    await env.DB.prepare(`
      INSERT INTO reports(
        id,
        user_id,
        description,
        location_name,
        latitude,
        longitude,
        observed_at,
        status,
        expires_at,
        route_id,
        stop_id,
        gps_confirmed
      )
      VALUES(?,?,?,?,?,?,?,'pending',?,?,?,?)
    `).bind(
      randomId(),
      reportUserId,
      "",
      stop.stop_name,
      stop.stop_lat,
      stop.stop_lon,
      observed.toISOString(),
      new Date(Date.now()+REPORT_LIFETIME_HOURS*3600000).toISOString(),
      b.route_id,
      b.stop_id,
      gpsConfirmed
    ).run();

    return json({
      success:true,
      message:"Melding is meteen zichtbaar als niet bevestigd.",
      gps_confirmed:!!gpsConfirmed
    },201);
  }

  if(path === "/api/reports/vote" && method === "POST") {
    const b=await request.json().catch(()=>null);
    if(!b || typeof b.id!=="string" || !["still","gone"].includes(b.vote))return json({error:"Ongeldige bevestiging."},400);
    const report=await env.DB.prepare("SELECT id,status FROM reports WHERE id=? AND status IN ('pending','approved') AND expires_at>?").bind(b.id,new Date().toISOString()).first();
    if(!report)return json({error:"Deze melding is niet meer actief."},404);
    const user=await currentUser(request,env),ip=request.headers.get("CF-Connecting-IP")||"unknown";
    const voterKey=user?"user:"+user.id:"ip:"+await hashText(ip);
    if(!await rateLimitCommunity(env,"vote:"+voterKey,60,3600000))return json({error:"Je bevestigt te vaak. Probeer later opnieuw."},429);
    try{await env.DB.prepare("INSERT INTO community_votes(report_id,voter_key,vote,created_at) VALUES(?,?,?,?)").bind(b.id,voterKey,b.vote,new Date().toISOString()).run();}
    catch(e){return json({error:"Je hebt deze melding al beoordeeld."},409);}
    const c=await env.DB.prepare("SELECT SUM(CASE WHEN vote='still' THEN 1 ELSE 0 END) AS still_count,SUM(CASE WHEN vote='gone' THEN 1 ELSE 0 END) AS gone_count FROM community_votes WHERE report_id=?").bind(b.id).first();
    const still=Number(c?.still_count||0),gone=Number(c?.gone_count||0);
    if(gone>=3 && gone>=still+2)await env.DB.prepare("UPDATE reports SET status='rejected' WHERE id=? AND status='pending'").bind(b.id).run();
    else if(still>=3 && still>=gone+2)await env.DB.prepare("UPDATE reports SET status='approved' WHERE id=? AND status='pending'").bind(b.id).run();
    return json({success:true,still,gone});
  }

  if (path === "/api/admin/pending" && method === "GET") {
    const user = await currentUser(request,env);

    if (!user || user.role !== "admin") {
      return json({error:"Geen beheerdersrechten"},403);
    }

    const result = await env.DB.prepare(`
      SELECT
        r.id,
        r.description,
        r.location_name,
        r.latitude,
        r.longitude,
        r.observed_at,
        r.gps_confirmed,
        CASE WHEN r.route_id='all' THEN '—' ELSE tr.route_short_name END AS route_short_name,
        r.route_id,
        ts.stop_name
      FROM reports r
      LEFT JOIN transit_routes tr ON tr.route_id=r.route_id
      LEFT JOIN transit_stops ts ON ts.stop_id=r.stop_id
      WHERE r.status='pending'
      ORDER BY r.created_at DESC
      LIMIT 100
    `).all();

    return json({reports:result.results||[]});
  }

  if (path === "/api/admin/moderate" && method === "POST") {
    const user = await currentUser(request,env);

    if (!user || user.role !== "admin") {
      return json({error:"Geen beheerdersrechten"},403);
    }

    const b = await request.json().catch(()=>null);

    if (!b ||
        typeof b.id !== "string" ||
        !["approved","rejected"].includes(b.status)) {
      return json({error:"Ongeldige aanvraag"},400);
    }

    await env.DB.prepare(
      "UPDATE reports SET status=? WHERE id=? AND status IN ('pending','approved')"
    ).bind(b.status,b.id).run();

    return json({success:true});
  }

  return json({error:"Endpoint niet gevonden"},404);
}

// Lijntrajecten: gebouwd door .github/workflows/kaartdata.yml en bewaard op de branch "kaartdata".
const KAARTDATA_BRON = "https://raw.githubusercontent.com/eueclipseglasses-max/eclipseglasses-assets/kaartdata/";
async function kaartdata(request,pathname){
  if(request.method!=="GET"&&request.method!=="HEAD") return new Response("Method not allowed",{status:405});
  const naam=pathname.slice("/kaartdata/".length);
  if(!/^(index\.json|net\/-?\d{1,5}_-?\d{1,5}\.json)$/.test(naam)) return new Response("Niet gevonden",{status:404});
  const kort=naam==="index.json";
  const res=await fetch(KAARTDATA_BRON+naam,{cf:{cacheTtl:kort?900:86400,cacheEverything:true}});
  if(!res.ok) return new Response("Niet gevonden",{status:res.status===404?404:502});
  return new Response(res.body,{headers:{
    "Content-Type":"application/json; charset=utf-8",
    "Cache-Control":kort?"public, max-age=900":"public, max-age=86400",
    "X-Content-Type-Options":"nosniff"
  }});
}

export default {
  async fetch(request,env) {
    try {
      const url = new URL(request.url);

      if (["/manifest.webmanifest","/icon.svg","/app-icon.png","/sw.js"].includes(url.pathname)) {
        return await handleApi(request,env);
      }

      if (url.pathname.startsWith("/kaartdata/")) {
        return await kaartdata(request,url.pathname);
      }

      if (url.pathname.startsWith("/api/")) {
        if (!env.DB) {
          return json({
            error:"D1 databasebinding ontbreekt. Voeg de binding DB toe."
          },500);
        }

        return await handleApi(request,env);
      }

      if (request.method !== "GET") {
        return new Response("Method not allowed",{status:405});
      }

      if (request.method !== "GET") return new Response("Method not allowed",{status:405});
      if (!["/","/index.html","/over","/contact","/privacy","/voorwaarden","/misbruik"].includes(url.pathname)) {
        return new Response('<!doctype html><html lang="nl"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Pagina niet gevonden · De Golem</title><body style="margin:0;background:#f1e2c6;color:#3c2c20;font:16px Georgia,serif;min-height:100vh;display:grid;place-items:center;text-align:center"><main style="padding:32px"><h1>Deze pagina bestaat niet.</h1><p>Misschien is de link verouderd.</p><a href="/" style="color:#925b35">Terug naar De Golem</a></main></body></html>',{status:404,headers:{"Content-Type":"text/html; charset=utf-8","X-Content-Type-Options":"nosniff"}});
      }
      const infoPages={
        "/over":["Over De Golem","De Golem is een onafhankelijk initiatief waarop reizigers meldingen van platte banden op het De Lijn-netwerk kunnen bekijken en delen. De Golem is niet verbonden aan De Lijn."],
        "/contact":["Contact","Heb je een vraag of opmerking over De Golem? Gebruik voorlopig de optie Misbruik melden voor inhoudelijke meldingen. Een algemeen contactadres wordt toegevoegd zodra het officieel is vastgelegd."],
        "/privacy":["Privacy","Je kunt een melding insturen zonder account. Voor misbruikpreventie verwerkt de dienst technische gegevens zoals een gehashte netwerkidentificatie en tijdstip. Meldingen worden tijdelijk bewaard en verdwijnen na de ingestelde bewaartermijn. GPS-controle is optioneel; de exacte GPS-coördinaten worden niet publiek getoond of opgeslagen."],
        "/voorwaarden":["Voorwaarden","Gebruik De Golem alleen voor correcte, te goeder trouw gedeelde waarnemingen. Plaats geen persoonsgegevens, beledigingen of bewust foutieve meldingen. Meldingen zijn gebruikerswaarnemingen en worden niet onafhankelijk gegarandeerd. Beheerders kunnen inhoud verwijderen of afwijzen."],
        "/misbruik":["Misbruik melden","Vermoed je een foutieve, dubbele of misbruikmakende melding? Noteer de halte, het tijdstip en de reden en neem contact op via het officiële contactkanaal zodra dit op deze pagina wordt gepubliceerd."]
      };
      if(infoPages[url.pathname]){
        const [title,body]=infoPages[url.pathname];
        return new Response('<!doctype html><html lang="nl"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#FBEED8"><title>'+title+' · De Golem</title><body style="margin:0;background:#f1e2c6;color:#3c2c20;font:17px Georgia,serif;line-height:1.6;min-height:100vh;display:grid;place-items:center"><main style="max-width:680px;padding:32px"><p style="letter-spacing:2px;color:#925b35">DE GOLEM</p><h1>'+title+'</h1><p>'+body+'</p><a href="/" style="color:#925b35">← Terug naar de kaart</a></main></body></html>',{headers:{"Content-Type":"text/html; charset=utf-8","X-Content-Type-Options":"nosniff"}});
      }
      let page=HTML;
      let viewer=null;
      if(env.DB){try{viewer=await currentUser(request,env);}catch(e){viewer=null;}}
      if(!viewer||viewer.role!=="admin"){
        page=page.replace(/\s*<section class="panel hidden" id="adminPanel">[\s\S]*?<\/section>/,"");
        page=page.replace(/async function loadPending\(\)\{[\s\S]*?\n\}\n(?=\$\('reportsList'\)\.addEventListener)/,"");
        page=page.replace(/\$\('pendingList'\)\.addEventListener\('click'[\s\S]*?\n\}\);\n/,"");
      }
      page=page.replace(/<meta property="og:image" content="\/app-icon\.png">[\s\S]*?<meta name="twitter:description" content="Bekijk en meld platte banden op het De Lijn-netwerk\.">/,'<meta property="og:image" content="'+url.origin+'/app-icon.png">');
      return new Response(page,{
        headers:{
          "Content-Type":"text/html; charset=utf-8",
          "Cache-Control":"no-store",
          "X-Content-Type-Options":"nosniff",
          "Referrer-Policy":"strict-origin-when-cross-origin",
          "Content-Security-Policy":"default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; connect-src 'self' https://tiles.openfreemap.org; font-src 'self' data: https://tiles.openfreemap.org; worker-src blob:;"
        }
      });

    } catch(error) {
      return json({
        error:String(error?.message || error)
      },500);
    }
  }
};
