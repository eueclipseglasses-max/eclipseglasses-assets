      }

    ];


    let cart =
      JSON.parse(
        localStorage.getItem(
          "eclipse_cart"
        ) || "[]"
      );


    function getUnitPrice(quantity) {

      for (
        const tier of PRICE_TIERS
      ) {

        if (
          quantity >= tier.min
        ) {

          return tier.price;

        }

      }

      return 4.95;

    }


    function getCartCount() {

      return cart.reduce(
        (
          sum,
          item
        ) =>
          sum +
          item.quantity,
        0
      );

    }


    function saveCart() {

      localStorage.setItem(
        "eclipse_cart",
        JSON.stringify(cart)
      );

      renderCart();

    }


    function addToCart() {

      const quantityInput =
        document.getElementById(
          "quantity"
        );


      let quantity =
        parseInt(
          quantityInput.value,
          10
        );


      if (
        !quantity ||
        quantity < 1
      ) {

        quantity = 1;

      }


      const existing =
        cart.find(
          item =>
            item.id ===
            "solar-glasses"
        );


      if (existing) {

        existing.quantity +=
          quantity;

      } else {

        cart.push({

          id:
            "solar-glasses",

          name:
            "Solar Eclipse Glasses",

          quantity:
            quantity

        });

      }


      saveCart();
      openCart();

    }


    function changeQuantity(
      index,
      amount
    ) {

      if (!cart[index]) {
        return;
      }


      cart[index].quantity +=
        amount;


      if (
        cart[index].quantity <= 0
      ) {

        cart.splice(
          index,
          1
        );

      }


      saveCart();

    }


    function removeItem(index) {

      cart.splice(
        index,
        1
      );

      saveCart();

    }


    function renderCart() {

      const container =
        document.getElementById(
          "cartItems"
        );


      const count =
        document.getElementById(
          "cartCount"
        );


      const totalElement =
        document.getElementById(
          "cartTotal"
        );


      count.textContent =
        getCartCount();


      if (!cart.length) {

        container.innerHTML =
          '<div class="cart-empty">' +
            'Your cart is empty.' +
          '</div>';


        totalElement.textContent =
          "€0.00";


        return;

      }


      let total = 0;
      let cartHTML = "";


      cart.forEach(
        (
          item,
          index
        ) => {


          const unitPrice =
            getUnitPrice(
              item.quantity
            );


          const itemTotal =
            unitPrice *
            item.quantity;


          total +=
            itemTotal;


          cartHTML +=

            '<div class="cart-item">' +

              '<div>' +

                '<div class="cart-item-name">' +
                  escapeHTML(
                    item.name
                  ) +
                '</div>' +

                '<div class="cart-item-detail">' +
                  '€' +
                  unitPrice.toFixed(2) +
                  ' / pair' +
                '</div>' +

                '<div class="cart-controls">' +

                  '<button ' +
                    'class="cart-control" ' +
                    'onclick="changeQuantity(' +
                      index +
                      ', -1)"' +
                  '>−</button>' +

                  '<span>' +
                    item.quantity +
                  '</span>' +

                  '<button ' +
                    'class="cart-control" ' +
                    'onclick="changeQuantity(' +
                      index +
                      ', 1)"' +
                  '>+</button>' +

                  '<button ' +
                    'class="remove-item" ' +
                    'onclick="removeItem(' +
                      index +
                    ')"' +
                  '>' +
                    'Remove' +
                  '</button>' +

                '</div>' +

              '</div>' +

              '<div class="cart-item-price">' +
                '€' +
                itemTotal.toFixed(2) +
              '</div>' +

            '</div>';

        }
      );


      container.innerHTML =
        cartHTML;


      totalElement.textContent =
        "€" +
        total.toFixed(2);

    }


    function escapeHTML(value) {

      return String(value)

        .replace(
          /&/g,
          "&amp;"
        )

        .replace(
          /</g,
          "&lt;"
        )

        .replace(
          />/g,
          "&gt;"
        )

        .replace(
          /"/g,
          "&quot;"
        )

        .replace(
          /'/g,
          "&#039;"
        );

    }


    function openCart() {

      document
        .getElementById(
          "cartDrawer"
        )
        .classList.add(
          "open"
        );


      document
        .getElementById(
          "cartOverlay"
